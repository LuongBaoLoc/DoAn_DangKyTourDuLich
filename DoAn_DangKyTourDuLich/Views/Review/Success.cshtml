@model Order
@{
    ViewData["Title"] = "Đánh giá thành công";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm text-center" style="border-radius: var(--radius);">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="fas fa-check-circle fa-5x text-success"></i>
                    </div>
                    <h2 class="fw-bold text-success mb-2">Cảm ơn bạn!</h2>
                    <p class="text-muted fs-5 mb-4">Đánh giá của bạn đã được ghi nhận thành công.</p>

                    @if (Model.Reviews?.Any() == true)
                    {
                        var review = Model.Reviews.FirstOrDefault();
                        <div class="bg-light p-4 rounded mb-4 text-start">
                            <div class="mb-3">
                                <strong>Xếp hạng:</strong>
                                <div class="mt-2">
                                    @for (int i = 0; i < review.Rating; i++)
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    @for (int i = review.Rating; i < 5; i++)
                                    {
                                        <i class="far fa-star text-warning"></i>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(review.Comment))
                            {
                                <div>
                                    <strong>Bình luận:</strong>
                                    <p class="text-muted mt-2">@review.Comment</p>
                                </div>
                            }
                        </div>
                    }

                    <p class="text-muted mb-4">Đánh giá của bạn giúp chúng tôi cải thiện dịch vụ ngày càng tốt hơn.</p>

                    <div class="d-grid gap-2">
                        <a asp-controller="Tour" asp-action="MyOrders" class="btn btn-primary btn-lg" style="border-radius: var(--radius);">
                            <i class="fas fa-list me-2"></i>Xem đơn hàng của tôi
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg" style="border-radius: var(--radius);">
                            <i class="fas fa-home me-2"></i>Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
