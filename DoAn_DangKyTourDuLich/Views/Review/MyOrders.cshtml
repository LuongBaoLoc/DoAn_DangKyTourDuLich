@model List<DoAn_DangKyTourDuLich.Services.OrderReviewInfo>
@{
    ViewData["Title"] = "Các chuyến đi của tôi";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">
                <i class="fas fa-list me-2"></i>Các chuyến đi của tôi
            </h2>
            <p class="text-muted">Danh sách các chuyến đi bạn đã hoàn thành. Bạn có thể đánh giá chuyến đi sau khi chúng kết thúc.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card border-0 bg-light">
            <div class="card-body text-center py-5">
                <i class="fas fa-inbox" style="font-size: 3rem; color: #ccc;"></i>
                <h5 class="mt-3">Chưa có chuyến đi nào hoàn thành</h5>
                <p class="text-muted">Khi bạn hoàn thành một chuyến đi, nó sẽ xuất hiện ở đây và bạn có thể đánh giá.</p>
                <a href="/Tour/Index" class="btn btn-primary">Xem các chuyến đi</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var order in Model)
            {
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: var(--radius);">
                        <div class="card-body">
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <p class="mb-1"><small class="text-muted">Mã đơn: <strong>@order.OrderCode</strong></small></p>
                                    <h5 class="card-title mb-0">@order.TourName</h5>
                                </div>
                                @if (order.HasReview)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle me-1"></i>Đã đánh giá
                                    </span>
                                }
                                else if (order.CanReview)
                                {
                                    <span class="badge bg-info">
                                        <i class="fas fa-star me-1"></i>Cần đánh giá
                                    </span>
                                }
                            </div>

                            <!-- Info grid -->
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <p class="mb-0"><small class="text-muted d-block">Ngày đặt</small><strong>@order.OrderDate.ToString("dd/MM/yyyy")</strong></p>
                                </div>
                                <div class="col-6">
                                    <p class="mb-0"><small class="text-muted d-block">Trạng thái</small>
                                        @if (order.Status == DoAn_DangKyTourDuLich.Models.OrderStatus.Completed)
                                        {
                                            <span class="badge bg-success">Đã hoàn thành</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Chưa hoàn thành</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            @if (order.TourEndDate.HasValue)
                            {
                                <p class="mb-3"><small class="text-muted d-block">Kết thúc:</small> @order.TourEndDate.Value.ToString("dd/MM/yyyy")</p>
                            }

                            <!-- Review status message -->
                            @if (order.CanReview)
                            {
                                <div class="alert alert-info small mb-3">
                                    <i class="fas fa-check me-2"></i>Bạn có thể đánh giá chuyến đi này
                                </div>
                                <a href="/Review/AddReview/@order.OrderId" class="btn btn-primary w-100">
                                    <i class="fas fa-star me-2"></i>Viết đánh giá
                                </a>
                            }
                            else if (order.HasReview)
                            {
                                <div class="alert alert-success small mb-3">
                                    <i class="fas fa-check me-2"></i>Bạn đã đánh giáchuyến đi này
                                </div>
                                <a href="/Review/AddReview/@order.OrderId" class="btn btn-secondary w-100">
                                    <i class="fas fa-edit me-2"></i>Cập nhật đánh giá
                                </a>
                            }
                            else
                            {
                                <div class="alert alert-warning small mb-3">
                                    <i class="fas fa-clock me-2"></i>@order.CanReviewReason
                                </div>
                                <button class="btn btn-secondary w-100" disabled>
                                    <i class="fas fa-lock me-2"></i>Không thể đánh giá
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
