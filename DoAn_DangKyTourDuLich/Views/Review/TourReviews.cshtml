@model List<DoAn_DangKyTourDuLich.Models.Review>
@{
    ViewData["Title"] = $"Đánh giá cho {ViewBag.TourName}";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">
                <i class="fas fa-star text-warning me-2"></i>Đánh giá cho @ViewBag.TourName
            </h2>
            <p class="text-muted">Những đánh giá từ những du khách đã trải nghiệm chuyến đi này</p>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 bg-light">
            <div class="card-body text-center py-5">
                <i class="fas fa-comments" style="font-size: 3rem; color: #ccc;"></i>
                <h5 class="mt-3">Chưa có đánh giá nào</h5>
                <p class="text-muted">Hãy là người đầu tiên đánh giá chuyến đi này!</p>
            </div>
        </div>
    }
    else
    {
        <!-- Summary stats -->
        <div class="row mb-4">
            <div class="col-auto">
                @{
                    var avgRating = Math.Round(Model.Average(r => r.Rating), 1);
                    var ratingCounts = Model.GroupBy(r => r.Rating).ToDictionary(g => g.Key, g => g.Count());
                }
                <div class="d-flex align-items-center gap-3">
                    <div>
                        <h3 class="fw-bold mb-0">@avgRating</h3>
                        <div class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                @if (i <= Math.Round(avgRating))
                                {
                                    <i class="fas fa-star"></i>
                                }
                                else
                                {
                                    <i class="far fa-star"></i>
                                }
                            }
                        </div>
                        <small class="text-muted">dựa trên @Model.Count đánh giá</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reviews list -->
        <div class="row g-3">
            @foreach (var review in Model)
            {
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">@review.User?.FullName</h5>
                                    <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <!-- Stars -->
                                <div class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        @if (i <= review.Rating)
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star"></i>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Comment -->
                            <p class="card-text text-muted mb-3">@review.Comment</p>

                            <!-- Images -->
                            @if (review.ImageUrls.Any())
                            {
                                <div class="mb-3">
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var imageUrl in review.ImageUrls)
                                        {
                                            <div>
                                                <a href="@imageUrl" target="_blank" class="d-inline-block">
                                                    <img src="@imageUrl" alt="Review image" 
                                                         style="max-width: 150px; max-height: 150px; object-fit: cover; border-radius: 8px; cursor: pointer;" />
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Badge -->
                            <div>
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i>Đã xác thực
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination (if needed) -->
        @if (ViewBag.PageIndex > 0 || Model.Count >= 10)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    @if (ViewBag.PageIndex > 0)
                    {
                        <li class="page-item">
                            <a class="page-link" href="/Review/TourReviews/@ViewBag.TourId?pageIndex=@(ViewBag.PageIndex - 1)">
                                <i class="fas fa-chevron-left me-1"></i>Trang trước
                            </a>
                        </li>
                    }
                    <li class="page-item active">
                        <span class="page-link">Trang @(ViewBag.PageIndex + 1)</span>
                    </li>
                    @if (Model.Count >= 10)
                    {
                        <li class="page-item">
                            <a class="page-link" href="/Review/TourReviews/@ViewBag.TourId?pageIndex=@(ViewBag.PageIndex + 1)">
                                Trang sau<i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
