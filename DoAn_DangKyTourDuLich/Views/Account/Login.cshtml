@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container">
    <div class="auth-card card">
        <div class="card-header">
            <h3 class="mb-0"><i class="fas fa-sign-in-alt me-2"></i>Đăng Nhập</h3>
            <p class="mb-0 mt-2 opacity-75">Chào mừng bạn quay lại!</p>
        </div>
        <div class="card-body">
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="Nhập email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="fas fa-sign-in-alt me-2"></i>Đăng Nhập
                </button>
            </form>

            <div class="text-center mt-3">
                <p class="text-muted mb-2">Hoặc đăng nhập bằng</p>
                <div class="d-flex justify-content-center gap-2">
                    <form asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="w-100">
                        <button type="submit" name="provider" value="Google" class="btn btn-outline-danger w-100 fw-semibold">
                            <i class="fab fa-google me-2"></i>Google
                        </button>
                    </form>
                    <form asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="w-100">
                        <button type="submit" name="provider" value="Facebook" class="btn btn-outline-primary w-100 fw-semibold">
                            <i class="fab fa-facebook-f me-2"></i>Facebook
                        </button>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted">Chưa có tài khoản?
                    <a asp-action="Register" class="fw-semibold text-decoration-none">Đăng ký ngay</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
