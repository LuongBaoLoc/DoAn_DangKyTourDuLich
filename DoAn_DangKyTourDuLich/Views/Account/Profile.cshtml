@model User
@{
    ViewData["Title"] = "Thông tin tài khoản";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm" style="border-radius: var(--radius);">
                <div class="card-header bg-primary text-white text-center py-4" style="border-radius: var(--radius) var(--radius) 0 0;">
                    <i class="fas fa-user-circle fa-4x mb-2"></i>
                    <h4 class="fw-bold mb-0">@Model.FullName</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-4 fw-semibold text-muted"><i class="fas fa-envelope me-2"></i>Email:</div>
                        <div class="col-8">@Model.Email</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-4 fw-semibold text-muted"><i class="fas fa-phone me-2"></i>Số điện thoại:</div>
                        <div class="col-8">@(Model.PhoneNumber ?? "Chưa cập nhật")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-4 fw-semibold text-muted"><i class="fas fa-map-marker-alt me-2"></i>Địa chỉ:</div>
                        <div class="col-8">@(Model.Address ?? "Chưa cập nhật")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-4 fw-semibold text-muted"><i class="fas fa-calendar me-2"></i>Ngày tham gia:</div>
                        <div class="col-8">@Model.CreatedAt.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
