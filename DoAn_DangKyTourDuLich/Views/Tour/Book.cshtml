@model CheckoutViewModel
@{
    ViewData["Title"] = "Đặt Tour - " + Model.Tour?.Name;
}

<div class="bg-light py-5">
<div class="container">
    <form asp-action="Book" method="post" id="bookingForm">
        <input type="hidden" asp-for="TourId" />
        <input type="hidden" asp-for="Quantity" id="totalQuantityHidden" />
        <input type="hidden" asp-for="SelectedDate" />
        
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <!-- Progress Steps (Visual Only) -->
        <div class="row justify-content-center mb-5">
            <div class="col-8 d-flex justify-content-between position-relative">
                <div class="position-absolute top-50 start-0 w-100" style="height: 2px; background-color: #ddd; z-index: 1;"></div>
                
                <div class="text-center position-relative" style="z-index: 2;">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-2 shadow" style="width: 45px; height: 45px;">
                        <i class="fas fa-file-alt fs-5"></i>
                    </div>
                    <div class="fw-bold text-primary small text-uppercase">Nhập thông tin</div>
                </div>
                <div class="text-center position-relative" style="z-index: 2;">
                    <div class="rounded-circle bg-white text-muted border d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px;">
                        <i class="fas fa-credit-card fs-5"></i>
                    </div>
                    <div class="fw-bold text-muted small text-uppercase">Thanh toán</div>
                </div>
                <div class="text-center position-relative" style="z-index: 2;">
                    <div class="rounded-circle bg-white text-muted border d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px;">
                        <i class="fas fa-check fs-5"></i>
                    </div>
                    <div class="fw-bold text-muted small text-uppercase">Hoàn tất</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Form -->
            <div class="col-lg-8">
                <!-- THÔNG TIN LIÊN LẠC -->
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-uppercase mb-4">Thông tin liên lạc</h5>
                        

                        <div class="row g-3">
                            <div class="col-md-6 position-relative">
                                <label asp-for="CustomerName" class="form-label fw-semibold">Họ tên <span class="text-danger">*</span></label>
                                <input asp-for="CustomerName" class="form-control" placeholder="Nhập họ tên" />
                                <span asp-validation-for="CustomerName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 position-relative">
                                <label asp-for="CustomerPhone" class="form-label fw-semibold">Điện thoại <span class="text-danger">*</span></label>
                                <input asp-for="CustomerPhone" class="form-control" placeholder="Nhập số điện thoại" />
                                <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 position-relative">
                                <label asp-for="CustomerEmail" class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                                <input asp-for="CustomerEmail" class="form-control" placeholder="Nhập email" />
                                <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 position-relative">
                                <label asp-for="CustomerAddress" class="form-label fw-semibold">Địa chỉ</label>
                                <input asp-for="CustomerAddress" class="form-control" placeholder="Nhập địa chỉ" />
                            </div>
                            <div class="col-12 position-relative">
                                <label asp-for="Note" class="form-label fw-semibold">Yêu cầu đặc biệt</label>
                                <textarea asp-for="Note" class="form-control" rows="2" placeholder="Ghi chú thêm..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HÀNH KHÁCH -->
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-uppercase mb-4">Hành khách</h5>
                        
                        <div class="row g-3">
                            <!-- Người lớn -->
                            <div class="col-md-6">
                                <div class="border rounded p-3 d-flex justify-content-between align-items-center bg-white" style="border-color: #333 !important;">
                                    <div>
                                        <div class="fw-bold">Người lớn</div>
                                        <div class="small text-muted">Từ 12 tuổi trở lên</div>
                                    </div>
                                    <div class="input-group input-group-sm" style="width: 110px;">
                                        <button class="btn btn-outline-secondary px-2 border-0" type="button" onclick="updateQty('AdultQuantity', -1)">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                        <input type="text" class="form-control text-center bg-transparent border-0 fw-bold fs-5" asp-for="AdultQuantity" readonly>
                                        <button class="btn btn-outline-secondary px-2 border-0" type="button" onclick="updateQty('AdultQuantity', 1)">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Trẻ nhỏ -->
                            <div class="col-md-6">
                                <div class="border rounded p-3 d-flex justify-content-between align-items-center bg-white" style="border-color: #333 !important;">
                                    <div>
                                        <div class="fw-bold text-dark">Trẻ nhỏ</div>
                                        <div class="small text-muted">Từ 5 - 11 tuổi</div>
                                    </div>
                                    <div class="input-group input-group-sm" style="width: 110px;">
                                        <button class="btn btn-outline-secondary px-2 border-0" type="button" onclick="updateQty('ChildQuantity', -1)">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                        <input type="text" class="form-control text-center bg-transparent border-0 fw-bold fs-5" asp-for="ChildQuantity" readonly>
                                        <button class="btn btn-outline-secondary px-2 border-0" type="button" onclick="updateQty('ChildQuantity', 1)">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        

                    </div>
                </div>

                <!-- THANH TOÁN -->
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-uppercase mb-4">Phương thức thanh toán</h5>
                        <div class="d-flex flex-wrap gap-3">
                            <div class="form-check border rounded p-3 bg-white" style="flex: 1; min-width: 200px;">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="0" id="pm0" checked />
                                <label class="form-check-label ms-2" for="pm0">
                                    <i class="fas fa-money-bill-wave text-success fs-5 me-2"></i>Tiền mặt
                                </label>
                            </div>
                            <div class="form-check border rounded p-3 bg-white" style="flex: 1; min-width: 200px;">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="1" id="pm1" />
                                <label class="form-check-label ms-2" for="pm1">
                                    <i class="fas fa-university text-primary fs-5 me-2"></i>Chuyển khoản
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Column: Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm" style="border-radius: 12px; font-size: 0.95rem; margin-bottom: 2rem;">
                    <div class="card-body p-0">
                        <!-- Header -->
                        <div class="p-4 border-bottom bg-light" style="border-radius: 12px 12px 0 0;">
                            <h5 class="fw-bold text-uppercase mb-0">Tóm tắt chuyến đi</h5>
                        </div>
                        
                        <!-- Product Info -->
                        <div class="p-4 border-bottom">
                            <div class="d-flex gap-3 mb-3">
                                @if (!string.IsNullOrEmpty(Model.Tour?.ImageUrl))
                                {
                                    <img src="@Model.Tour.ImageUrl" alt="@Model.Tour.Name" class="rounded" style="width: 100px; height: 75px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded bg-secondary d-flex align-items-center justify-content-center" style="width: 100px; height: 75px;"><i class="fas fa-image text-white"></i></div>
                                }
                                <div>
                                    <h6 class="fw-bold mb-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@Model.Tour?.Name</h6>
                                    <!-- TourCode info removed -->
                                </div>
                            </div>
                        </div>

                        <!-- Transport Info -->
                        @{
                            int travelHoursB = 2 + (Model.TourId % 6);
                            int depHourB = 5 + (Model.TourId % 4);
                            int depMinuteB = (Model.TourId % 2 == 0) ? 0 : 30;
                            DateTime timeGoStartB = new DateTime(2000, 1, 1, depHourB, depMinuteB, 0);
                            DateTime timeGoEndB = timeGoStartB.AddHours(travelHoursB);
                            string transitIconB = (Model.Tour?.Transportation != null && Model.Tour.Transportation.Contains("Máy bay")) ? "fa-plane" : "fa-bus";
                        }
                        
                        <div class="p-4 border-bottom bg-light bg-opacity-50">
                            <h6 class="fw-bold mb-3"><i class="fas @transitIconB text-secondary me-2"></i>THÔNG TIN CHUYẾN ĐI</h6>
                            <div class="d-flex justify-content-between text-muted small mb-1">
                                <div>Ngày khởi hành: <strong class="text-dark" id="dispStartDate">@(string.IsNullOrEmpty(Model.SelectedDate) ? (Model.Tour?.DepartureDate?.ToString("dd/MM/yyyy") ?? "--/--/----") : DateTime.Parse(Model.SelectedDate).ToString("dd/MM/yyyy"))</strong></div>
                                <div>Thời gian lưu trú: <strong class="text-dark" id="dispDuration">@(Model.Tour?.Duration) ngày</strong></div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold fs-5">@timeGoStartB.ToString("HH:mm")</span>
                                <div class="flex-grow-1 mx-3 text-center text-muted" style="height: 1px; background-color: #ddd; position: relative;"><i class="fas @transitIconB position-absolute top-50 start-50 translate-middle bg-light px-2"></i></div>
                                <span class="fw-bold fs-5">@timeGoEndB.ToString("HH:mm")</span>
                            </div>
                            <div class="d-flex justify-content-between text-muted fw-medium fs-6">
                                <span>@Model.Tour?.DepartureLocation</span>
                                <span>@Model.Tour?.Destination</span>
                            </div>
                        </div>

                        <!-- Pricing Breakdown -->
                        <div class="p-4 border-bottom">
                            <h6 class="fw-bold mb-3"><i class="fas fa-users text-secondary me-2"></i>KHÁCH HÀNG + PHỤ THU</h6>
                            <div id="priceBreakdownList">
                                <!-- Rendered by JS -->
                            </div>
                        </div>

                        <!-- Promo Code section removed -->

                        <!-- Policy checkbox -->
                        <div class="p-4 py-3 border-bottom bg-light bg-opacity-50">
                            <div class="form-check small">
                                <input class="form-check-input" type="checkbox" id="policyCheck" checked>
                                <label class="form-check-label text-muted" for="policyCheck">
                                    Tôi đồng ý với <a href="#" class="text-primary text-decoration-none">Chính sách bảo vệ dữ liệu cá nhân</a> và <a href="#" class="text-primary text-decoration-none">các điều khoản</a>.
                                </label>
                            </div>
                        </div>

                        <!-- Total -->
                        <div class="p-4">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="fw-bold fs-5 text-dark">Tổng tiền</span>
                                <span class="fw-bold fs-3 text-danger" id="displayTotalAmount">0 đ</span>
                            </div>

                            <button type="button" class="btn w-100 py-3 fw-bold text-white fs-5" id="btnSubmitForm" style="background-color: #e02000; border-radius: 8px;">
                                Đặt ngay
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const M_ADULT = @(Model.Tour?.DisplayPrice ?? 0);
        const M_CHILD = @((Model.Tour?.DisplayPrice / 2) ?? 0);
        
        // Auto fill end date
        try {
            var startDtStr = document.getElementById('dispStartDate').innerText;
            if(startDtStr && startDtStr !== '--/--/----') {
                var p = startDtStr.split('/');
                var d = new Date(p[2], p[1]-1, p[0]);
                d.setDate(d.getDate() + @(Model.Tour?.Duration ?? 1) - 1);
                document.getElementById('dispEndDate').innerText = `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`;
            }
        } catch(e) {}

        function updateQty(id, change) {
            var input = document.getElementById(id);
            var currentVal = parseInt(input.value) || 0;
            var newVal = currentVal + change;
            
            // Validate limits
            if (id === 'AdultQuantity' && newVal < 1) newVal = 1;
            else if (newVal < 0) newVal = 0;
            
            input.value = newVal;
            calculateTotal();
        }

        function calculateTotal() {
            var a = parseInt(document.getElementById('AdultQuantity').value) || 0;
            var c = parseInt(document.getElementById('ChildQuantity').value) || 0;
            
            var totalQty = a + c;
            document.getElementById('totalQuantityHidden').value = totalQty;
            
            var totalAmount = (a * M_ADULT) + (c * M_CHILD);
            
            // Build UI Right Panel
            var listHtml = '';
            if(a > 0) listHtml += `<div class="d-flex justify-content-between mb-2"><span class="text-dark">Người lớn</span><span class="text-danger fw-bold">${a} x ${(M_ADULT).toLocaleString('vi-VN')} đ</span></div>`;
            if(c > 0) listHtml += `<div class="d-flex justify-content-between mb-2"><span class="text-dark">Trẻ nhỏ</span><span class="text-danger fw-bold">${c} x ${(M_CHILD).toLocaleString('vi-VN')} đ</span></div>`;
            
            document.getElementById('priceBreakdownList').innerHTML = listHtml;
            document.getElementById('displayTotalAmount').innerText = totalAmount.toLocaleString('vi-VN') + ' đ';
        }

        document.getElementById('btnSubmitForm').addEventListener('click', function(e) {
            e.preventDefault();
            if(!document.getElementById('policyCheck').checked) {
                alert('Vui lòng đồng ý với chính sách và điều khoản để tiếp tục!');
                return;
            }
            document.getElementById('bookingForm').submit();
        });

        // Initialize display
        document.addEventListener('DOMContentLoaded', calculateTotal);
    </script>
}
