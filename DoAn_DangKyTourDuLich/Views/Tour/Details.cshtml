@model DoAn_DangKyTourDuLich.Models.ViewModels.TourDetailsViewModel
@inject DoAn_DangKyTourDuLich.Services.HtmlSanitizeService HtmlSanitizer
@{
    ViewData["Title"] = Model.Tour.Name;
    var tour = Model.Tour;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3 page-breadcrumb" data-reveal="up">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Tour" asp-action="Index">Tour</a></li>
            <li class="breadcrumb-item active">@tour.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="tour-detail-img mb-4 shadow-sm rounded overflow-hidden" data-reveal="up">
                <img src="@tour.ImageUrl" alt="@tour.Name" id="tour-main-image" class="w-100" style="height: 450px; object-fit: cover;" />
            </div>

            <h1 class="fw-bold mb-3 text-primary" style="font-size: 2rem;" data-reveal="up">@tour.Name</h1>

            <ul class="nav nav-tabs nav-justified mb-4 bg-white panel-card border-0 shadow-sm" id="tourTab" role="tablist" style="border-radius: 12px; overflow: hidden;">
                <li class="nav-item">
                    <button class="nav-link active py-3 fw-bold tour-tab-btn" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button">Tổng quan</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-3 fw-bold tour-tab-btn" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule" type="button">Lịch trình</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-3 fw-bold tour-tab-btn" id="calendar-tab" data-bs-toggle="tab" data-bs-target="#calendar" type="button">Ngày khởi hành</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-3 fw-bold tour-tab-btn" id="notes-tab" data-bs-toggle="tab" data-bs-target="#notes" type="button">Chính sách</button>
                </li>
            </ul>

            <div class="tab-content" id="tourTabContent">
                <div class="tab-pane fade show active panel-card p-4 border-0 mb-4 bg-white shadow-sm rounded-3" id="overview">
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <span class="badge bg-light text-primary border px-3 py-2"><i class="fas fa-clock me-2"></i>@tour.Duration ngày</span>
                        <span class="badge bg-light text-success border px-3 py-2"><i class="fas fa-bus me-2"></i>@tour.Transportation</span>
                        <span class="badge bg-light text-danger border px-3 py-2"><i class="fas fa-map-marker-alt me-2"></i>@tour.Destination</span>
                        @if (tour.Category != null)
                        {
                            <span class="badge bg-light text-warning border px-3 py-2"><i class="fas fa-tags me-2"></i>@tour.Category.Name</span>
                        }
                    </div>
                    <h5 class="fw-bold border-start border-primary border-4 ps-2 mb-3">Mô tả chuyến đi</h5>
                    <p class="text-muted" style="line-height: 1.8;">@tour.ShortDescription</p>
                    <div class="mt-3">@Html.Raw(HtmlSanitizer.Sanitize(tour.DetailDescription?.Replace("\n", "<br/>") ?? ""))</div>
                </div>

                <div class="tab-pane fade panel-card p-4 bg-white shadow-sm rounded-3 mb-4" id="schedule">
                    <h5 class="fw-bold mb-4 text-uppercase"><i class="bi bi-map text-primary"></i> Hành trình chi tiết</h5>
                    <div class="itinerary-timeline">
                        @if (!string.IsNullOrEmpty(tour.Schedule))
                        {
                            var days = tour.Schedule.Split('|');
                            foreach (var dayContent in days)
                            {
                                var parts = dayContent.Split(':');
                                <div class="timeline-item d-flex mb-4">
                                    <div class="timeline-badge bg-primary text-white fw-bold shadow-sm">
                                        @(parts.Length > 1 ? parts[0].Trim() : "Lịch")
                                    </div>
                                    <div class="timeline-content ms-3 p-3 border-0 bg-light rounded-3 w-100">
                                        <p class="mb-0 fw-medium">@(parts.Length > 1 ? parts[1].Trim() : parts[0].Trim())</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted fst-italic">Đang cập nhật lịch trình chi tiết...</p>
                        }
                    </div>
                </div>

                <div class="tab-pane fade panel-card p-4 bg-white shadow-sm rounded-3 mb-4" id="calendar">
                    <h4 class="text-center fw-bold mb-4">LỊCH KHỞI HÀNH</h4>
                    <div class="row">
                        <!-- Left Column: Month Selector -->
                        <div class="col-md-3 mb-3 mb-md-0">
                            <div class="card border-0 shadow-sm rounded-3 h-100">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-4 text-center">Chọn tháng</h6>
                                    <div class="d-flex flex-column gap-2" id="month-selector-container">
                                        @{
                                            var currentMonth = DateTime.Now;
                                            for (int i = 0; i < 6; i++)
                                            {
                                                var mDate = currentMonth.AddMonths(i);
                                                <button class="btn btn-outline-primary border-0 fw-bold py-2 btn-lg month-btn @(i == 0 ? "active text-white bg-primary" : "text-primary")"
                                                        onclick="changeMonth(this)" data-month="@mDate.Month" data-year="@mDate.Year" id="month-btn-@mDate.Month-@mDate.Year">
                                                    @mDate.Month/@mDate.Year
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Calendar Grid -->
                        <div class="col-md-9">
                            <div class="card border-0 shadow-sm rounded-3 h-100">
                                <div class="card-body p-2 p-md-4">
                                    <div class="d-flex justify-content-center align-items-center mb-4">
                                        <button class="btn btn-light rounded-circle shadow-sm" onclick="prevMonth()"><i class="fas fa-arrow-left"></i></button>
                                        <h5 class="fw-bold text-primary mx-4 mb-0" id="current-month-display">THÁNG @currentMonth.Month/@currentMonth.Year</h5>
                                        <button class="btn btn-light rounded-circle shadow-sm" onclick="nextMonth()"><i class="fas fa-arrow-right"></i></button>
                                    </div>

                                    <table class="table table-borderless text-center calendar-table mb-0">
                                        <thead>
                                            <tr>
                                                <th class="py-2 text-dark">T2</th>
                                                <th class="py-2 text-dark">T3</th>
                                                <th class="py-2 text-dark">T4</th>
                                                <th class="py-2 text-dark">T5</th>
                                                <th class="py-2 text-dark">T6</th>
                                                <th class="text-danger py-2">T7</th>
                                                <th class="text-danger py-2">CN</th>
                                            </tr>
                                        </thead>
                                        <tbody id="calendar-body"></tbody>
                                    </table>
                                    <p class="small text-danger fst-italic mt-4 mb-0 ms-2">Quý khách vui lòng chọn ngày phù hợp</p>

                                    <!-- Departure Time Selection (Hidden by default) -->
                                    <div id="departure-time-section" class="mt-4 pt-4 border-top d-none px-2">
                                        <h6 class="fw-bold text-primary mb-3">Chọn giờ khởi hành</h6>
                                        <div class="d-flex flex-wrap gap-2" id="departure-time-list">
                                            <button type="button" class="btn btn-outline-primary time-slot-btn" data-time="06:00" onclick="selectDepartureTime(this)">06:00</button>
                                            <button type="button" class="btn btn-outline-primary time-slot-btn" data-time="08:00" onclick="selectDepartureTime(this)">08:00</button>
                                            <button type="button" class="btn btn-outline-primary time-slot-btn" data-time="10:00" onclick="selectDepartureTime(this)">10:00</button>
                                            <button type="button" class="btn btn-outline-primary time-slot-btn" data-time="13:00" onclick="selectDepartureTime(this)">13:00</button>
                                            <button type="button" class="btn btn-outline-primary time-slot-btn" data-time="15:00" onclick="selectDepartureTime(this)">15:00</button>
                                            <button type="button" class="btn btn-outline-primary time-slot-btn" data-time="18:00" onclick="selectDepartureTime(this)">18:00</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade panel-card p-4 bg-white shadow-sm rounded-3 mb-4" id="notes">
                    <h5 class="fw-bold mb-3 text-danger">Lưu ý & Điều khoản</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="fw-bold text-primary small">BAO GỒM</h6>
                            <ul class="small text-muted">
                                <li>Vận chuyển: Xe du lịch đời mới máy lạnh.</li>
                                <li>Lưu trú: Khách sạn tiêu chuẩn (2-3 khách/phòng).</li>
                                <li>Ăn uống: Theo chương trình tour.</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold text-primary small">KHÔNG BAO GỒM</h6>
                            <ul class="small text-muted">
                                <li>Chi phí cá nhân, đồ uống ngoài chương trình.</li>
                                <li>Tiền tip cho hướng dẫn viên và tài xế.</li>
                                <li>Thuế VAT.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow sticky-top" style="top: 100px; border-radius: 15px;">
                <div id="sidebar-unselected" class="p-4">
                    <div class="small text-muted mb-1 text-uppercase fw-bold">Giá ưu đãi chỉ từ:</div>
                    <div class="h2 fw-bold text-danger mb-3">
                        @tour.DisplayPrice.ToString("N0") <span class="fs-6 fw-normal text-dark">đ / khách</span>
                    </div>

                    <div class="bg-light p-3 rounded-3 mb-4 border-start border-primary border-4">
                        <div class="small text-dark fw-bold mb-1"><i class="fas fa-users me-2"></i> Ưu đãi khách đoàn:</div>
                        <p class="small text-muted mb-0">Đi từ 10 khách trở lên? <span class="text-primary fw-bold">Hỗ trợ tách đoàn riêng</span>, xe riêng, lịch trình linh hoạt.</p>
                    </div>

                    @if (tour.AvailableSlots <= 0)
                    {
                        <button class="btn btn-secondary w-100 py-3 disabled"><i class="fas fa-ban me-2"></i> HẾT CHỖ</button>
                    }
                    else
                    {
                        <button class="btn btn-primary w-100 py-3 fw-bold fs-5 shadow" onclick="scrollToCalendar()" style="border-radius: 10px;">
                            <i class="fas fa-calendar-check me-2"></i> CHỌN NGÀY ĐI
                        </button>
                    }
                </div>

                <div id="sidebar-selected" class="p-4 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <button class="btn btn-sm btn-link text-decoration-none px-0" onclick="resetSidebar()"><i class="fas fa-undo me-1"></i> Đổi ngày</button>
                        <span class="badge bg-danger p-2" id="sb-selected-date"></span>
                    </div>

                    <div class="small text-muted mb-3">
                        Giờ khởi hành:
                        <span class="fw-bold text-primary" id="sb-selected-time">Chưa chọn</span>
                    </div>

                    <div class="price-summary mb-4 p-3 bg-light rounded-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Người lớn:</span>
                            <span class="fw-bold" id="sb-price-adult">@tour.DisplayPrice.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Trẻ em (5-11):</span>
                            <span class="fw-bold" id="sb-price-child">@((tour.DisplayPrice / 2).ToString("N0")) đ</span>
                        </div>
                    </div>

                    <a href="@Url.Action("Book", "Tour", new { id = tour.Id })" id="btn-submit-booking" class="btn btn-danger w-100 py-3 fw-bold fs-5 shadow disabled">ĐẶT TOUR NGAY</a>
                    <div class="text-center mt-3">
                        <small class="text-muted">Hotline: 038 535 3174</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.RelatedTours.Any())
    {
        <div class="mt-5 pt-5 border-top">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
                <div>
                    <h3 class="fw-bold mb-1"><i class="fas fa-magic text-primary me-2"></i>Có thể bạn cũng thích</h3>
                    <p class="text-muted mb-0">Gợi ý theo Content-Based Filtering dựa trên danh mục, điểm đến và mức giá của tour hiện tại.</p>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var item in Model.RelatedTours)
                {
                    <div class="col-md-6 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm recommendation-card">
                            <img src="@item.Tour.ImageUrl" class="card-img-top" alt="@item.Tour.Name" style="height: 170px; object-fit: cover;">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <span class="badge recommendation-score">Độ phù hợp @Math.Round(item.Score * 100, 0)%</span>
                                    @if (item.Tour.Category != null)
                                    {
                                        <span class="badge bg-light text-dark border">@item.Tour.Category.Name</span>
                                    }
                                </div>

                                <h6 class="card-title fw-bold mb-2">@item.Tour.Name</h6>
                                <div class="small text-muted mb-2"><i class="fas fa-map-marker-alt me-1"></i>@item.Tour.Destination</div>
                                <div class="text-danger fw-bold mb-3">@item.Tour.DisplayPrice.ToString("N0") đ</div>

                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    @foreach (var reason in item.Reasons)
                                    {
                                        <span class="badge recommendation-reason">@reason</span>
                                    }
                                </div>

                                <a href="/Tour/Details/@item.Tour.Id" class="btn btn-outline-primary rounded-pill mt-auto">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .tour-tab-btn { color: #666; border-bottom: 3px solid transparent !important; }
    .tour-tab-btn.active { color: #0d6efd !important; border-bottom: 3px solid #0d6efd !important; background: transparent !important; }
    .itinerary-timeline { position: relative; padding-left: 20px; }
    .itinerary-timeline::before { content: ''; position: absolute; left: 54px; top: 10px; bottom: 10px; width: 2px; background: #dee2e6; }
    .timeline-badge { min-width: 70px; height: 35px; display: flex; align-items: center; justify-content: center; border-radius: 18px; z-index: 1; font-size: 0.8rem; }
    .timeline-content { transition: 0.3s; border-left: 4px solid #0d6efd !important; }
    .timeline-content:hover { background-color: #fff !important; box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15) !important; }
    .calendar-table th { font-size: 0.95rem; font-weight: 700; padding-bottom: 20px; }
    .calendar-cell { height: 80px; width: 14.2%; vertical-align: middle; cursor: pointer; border-radius: 8px; font-size: 1rem; transition: all 0.2s; border: 1px solid transparent; }
    .calendar-cell.has-tour { color: #333; font-weight: bold; }
    .calendar-cell.has-tour:hover { border: 1px solid #dc3545; background: #fffafb; }
    .calendar-cell.selected { border: 1px solid #dc3545 !important; color: #333 !important; box-shadow: 0 4px 12px rgba(220, 53, 69, 0.15); }
    .calendar-cell.disabled-day { color: #ccc; cursor: not-allowed; }
    .calendar-cell.disabled-day:hover { border: 1px solid transparent; }
    .month-btn { transition: 0.2s; }
    .month-btn.active { background-color: #0d6efd !important; color: white !important; box-shadow: 0 4px 10px rgba(13, 110, 253, 0.3); }
    .time-slot-btn.active { background-color: #0d6efd !important; color: #fff !important; border-color: #0d6efd !important; }
    .recommendation-card { transition: transform 0.2s ease, box-shadow 0.2s ease; border-radius: 16px; overflow: hidden; }
    .recommendation-card:hover { transform: translateY(-4px); box-shadow: 0 1rem 2rem rgba(13, 110, 253, 0.12) !important; }
    .recommendation-score { background: linear-gradient(135deg, #0d6efd, #43a5ff); color: #fff; }
    .recommendation-reason { background: #eef6ff; color: #0d6efd; border: 1px solid #cfe2ff; font-weight: 500; }
</style>

<script>
    const GIA_MOC = @tour.DisplayPrice;
    const TODAY = new Date();
    TODAY.setHours(0, 0, 0, 0);
    let selectedDateValue = '';
    let selectedTimeValue = '';

    function scrollToCalendar() {
        const trigger = document.querySelector('#calendar-tab');
        new bootstrap.Tab(trigger).show();
        trigger.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function resetSidebar() {
        document.getElementById('sidebar-selected').classList.add('d-none');
        document.getElementById('sidebar-unselected').classList.remove('d-none');
        document.querySelectorAll('.calendar-cell').forEach(c => c.classList.remove('selected'));
        document.querySelectorAll('.time-slot-btn').forEach(btn => btn.classList.remove('active'));
        document.getElementById('departure-time-section').classList.add('d-none');
        document.getElementById('sb-selected-time').innerText = 'Chưa chọn';
        document.getElementById('btn-submit-booking').href = `/Tour/Book/@tour.Id`;
        document.getElementById('btn-submit-booking').classList.add('disabled');
        selectedDateValue = '';
        selectedTimeValue = '';
    }

    function selectDepartureTime(button) {
        if (!selectedDateValue) {
            return;
        }

        document.querySelectorAll('.time-slot-btn').forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        selectedTimeValue = button.dataset.time;
        document.getElementById('sb-selected-time').innerText = selectedTimeValue;
        document.getElementById('btn-submit-booking').href = `/Tour/Book/@tour.Id?date=${selectedDateValue}&time=${selectedTimeValue}`;
        document.getElementById('btn-submit-booking').classList.remove('disabled');
    }

    function changeMonth(btn) {
        document.querySelectorAll('.month-btn').forEach(b => {
            b.classList.remove('active', 'text-white', 'bg-primary');
            b.classList.add('text-primary');
        });
        btn.classList.add('active', 'text-white', 'bg-primary');
        btn.classList.remove('text-primary');
        const month = parseInt(btn.dataset.month);
        const year = parseInt(btn.dataset.year);
        document.getElementById('current-month-display').innerText = `THÁNG ${month}/${year}`;
        generateCalendar(year, month);
    }

    function prevMonth() {
        const activeBtn = document.querySelector('.month-btn.active');
        if (activeBtn && activeBtn.previousElementSibling) {
            changeMonth(activeBtn.previousElementSibling);
        }
    }

    function nextMonth() {
        const activeBtn = document.querySelector('.month-btn.active');
        if (activeBtn && activeBtn.nextElementSibling) {
            changeMonth(activeBtn.nextElementSibling);
        }
    }

    function generateCalendar(year, month) {
        const tbody = document.getElementById('calendar-body');
        if (!tbody) {
            return;
        }

        tbody.innerHTML = '';
        const firstDay = new Date(year, month - 1, 1).getDay();
        const daysInMonth = new Date(year, month, 0).getDate();
        const startOffset = firstDay === 0 ? 6 : firstDay - 1;
        
        let schedules = [];
        try {
            schedules = JSON.parse('@Html.Raw(ViewBag.SchedulesJson ?? "[]")');
        } catch(e) { }

        let date = 1;
        for (let i = 0; i < 6; i++) {
            let row = document.createElement('tr');
            for (let j = 0; j < 7; j++) {
                let cell = document.createElement('td');
                cell.className = 'calendar-cell';
                if ((i === 0 && j >= startOffset) || (i > 0 && date <= daysInMonth)) {
                    
                    const checkDate = new Date(year, month - 1, date);
                    checkDate.setHours(0, 0, 0, 0);
                    
                    const selectedMonth = String(month).padStart(2, '0');
                    const selectedDay = String(date).padStart(2, '0');
                    const dateStr = `${year}-${selectedMonth}-${selectedDay}`;
                    const schedule = schedules.find(s => s.date === dateStr);
                    
                    let cellHtml = `<div class="date-num" style="font-size:1.1em">${date}</div>`;
                    
                    if (schedule) {
                        cellHtml += `<div class="text-danger fw-bold mt-1" style="font-size:0.8rem">${(schedule.price/1000).toLocaleString('vi-VN')}K</div>`;
                        cell.classList.add('has-tour', 'admin-tour');
                    } else if (checkDate >= TODAY) {
                        cell.classList.add('has-tour', 'custom-tour');
                    } else {
                        cell.classList.add('disabled-day');
                    }
                    
                    cell.innerHTML = cellHtml;

                    if (checkDate >= TODAY) {
                        cell.onclick = function () {
                            document.querySelectorAll('.calendar-cell').forEach(c => c.classList.remove('selected'));
                            this.classList.add('selected');
                            document.getElementById('sidebar-unselected').classList.add('d-none');
                            document.getElementById('sidebar-selected').classList.remove('d-none');
                            document.getElementById('sb-selected-date').innerText = checkDate.toLocaleDateString('vi-VN');
                            document.querySelectorAll('.time-slot-btn').forEach(btn => btn.classList.remove('active'));
                            
                            selectedDateValue = dateStr;
                            selectedTimeValue = '';
                            
                            if (!schedule) {
                                document.getElementById('departure-time-section').classList.remove('d-none');
                                document.getElementById('sb-selected-time').innerHTML = '<span class="text-warning small"><i class="fas fa-info-circle"></i> Đoàn riêng (Tối thiểu 10 khách)</span>';
                                document.getElementById('btn-submit-booking').classList.add('disabled');
                                
                                // Reset to default price
                                document.getElementById('sb-price-adult').innerText = GIA_MOC.toLocaleString('vi-VN') + ' đ';
                                document.getElementById('sb-price-child').innerText = (GIA_MOC / 2).toLocaleString('vi-VN') + ' đ';
                            } else {
                                document.getElementById('departure-time-section').classList.add('d-none');
                                document.getElementById('sb-selected-time').innerHTML = '<span class="text-success fw-bold">Theo lịch trình (Ghép đoàn)</span>';
                                document.getElementById('btn-submit-booking').classList.remove('disabled');
                                
                                // Update to schedule price
                                document.getElementById('sb-price-adult').innerText = schedule.price.toLocaleString('vi-VN') + ' đ';
                                document.getElementById('sb-price-child').innerText = (schedule.price / 2).toLocaleString('vi-VN') + ' đ';
                            }
                            
                            document.getElementById('btn-submit-booking').href = `/Tour/Book/@tour.Id?date=${selectedDateValue}`;
                        };
                    }
                    date++;
                }
                row.appendChild(cell);
            }
            tbody.appendChild(row);
            if (date > daysInMonth) break;
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        const activeMonth = document.querySelector('.active-month');
        if (activeMonth) changeMonth(activeMonth);
    });
</script>
