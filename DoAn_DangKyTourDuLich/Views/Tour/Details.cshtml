@model Tour
@{
    ViewData["Title"] = Model.Name;
    var relatedTours = ViewBag.RelatedTours as List<Tour> ?? new List<Tour>();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3 page-breadcrumb" data-reveal="up">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Tour" asp-action="Index">Tour</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Main Content Column -->
        <div class="col-lg-8">
            <div class="tour-detail-img mb-4" data-reveal="up">
                @if (Model.GalleryImages.Any())
                {
                    <img src="@Model.GalleryImages.First()" alt="@Model.Name" id="tour-main-image" />
                }
                else
                {
                    <div class="tour-img-placeholder" style="height:400px;"><i class="fas fa-image fa-5x"></i></div>
                }
            </div>

            @if (Model.GalleryImages.Count > 1)
            {
                <div class="tour-gallery mb-4" data-reveal="up">
                    @foreach (var image in Model.GalleryImages)
                    {
                        <button type="button" class="tour-gallery__thumb @(image == Model.GalleryImages.First() ? "is-active" : "")" data-tour-thumb="@image">
                            <img src="@image" alt="@Model.Name" />
                        </button>
                    }
                </div>
            }

            <h1 class="fw-bold mb-3" style="font-size: 1.8rem;" data-reveal="up">@Model.Name</h1>

            <!-- Nav Tabs -->
            <ul class="nav nav-tabs nav-justified mb-4 bg-white panel-card border-0" id="tourTab" role="tablist" style="border-radius: 8px; overflow: hidden; font-size: 1rem;">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active py-3 fw-bold border-0 text-dark tour-tab-btn" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab" style="border-bottom: 3px solid transparent;">Tổng quan</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-3 fw-bold border-0 text-primary tour-tab-btn" id="calendar-tab" data-bs-toggle="tab" data-bs-target="#calendar" type="button" role="tab" style="border-bottom: 3px solid transparent;">Lịch khởi hành</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-3 fw-bold border-0 text-dark tour-tab-btn" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule" type="button" role="tab" style="border-bottom: 3px solid transparent;">Lịch trình</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-3 fw-bold border-0 text-dark tour-tab-btn" id="notes-tab" data-bs-toggle="tab" data-bs-target="#notes" type="button" role="tab" style="border-bottom: 3px solid transparent;">Lưu ý</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-3 fw-bold border-0 text-dark tour-tab-btn" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab" style="border-bottom: 3px solid transparent;">Đánh giá</button>
                </li>
            </ul>

            <div class="tab-content" id="tourTabContent">
                <!-- Tab Tổng Quan -->
                <div class="tab-pane fade show active panel-card p-4 border-0 mb-4" id="overview" role="tabpanel" style="border-radius: var(--radius);">
                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <span class="badge bg-primary bg-opacity-10 text-primary p-2 fs-6"><i class="fas fa-tag me-1"></i>@Model.Category?.Name</span>
                        <span class="badge bg-success bg-opacity-10 text-success p-2 fs-6"><i class="fas fa-clock me-1"></i>@Model.Duration ngày</span>
                        <span class="badge bg-danger bg-opacity-10 text-danger p-2 fs-6"><i class="fas fa-map-marker-alt me-1"></i>@Model.Destination</span>
                        @if (!string.IsNullOrEmpty(Model.Transportation))
                        {
                            <span class="badge bg-info bg-opacity-10 text-info p-2 fs-6"><i class="fas fa-bus me-1"></i>@Model.Transportation</span>
                        }
                    </div>
                    <h5 class="fw-bold mb-3">Mô tả</h5>
                    <p>@Model.ShortDescription</p>
                    @if (!string.IsNullOrEmpty(Model.DetailDescription))
                    {
                        <hr class="text-muted opacity-25" />
                        <div>@Html.Raw(Model.DetailDescription?.Replace("\n", "<br/>"))</div>
                    }

                    <h5 class="fw-bold mt-4 mb-3">Thông tin bổ sung</h5>
                    <div class="row text-center g-4 align-items-center">
                        <div class="col-md-4">
                            <i class="fas fa-map-marked-alt fa-2x text-primary mb-2"></i>
                            <h6 class="fw-bold">Điểm tham quan</h6>
                            <p class="text-muted small mb-0">@Model.Destination</p>
                        </div>
                        <div class="col-md-4">
                            <i class="fas fa-users-cog fa-2x text-primary mb-2"></i>
                            <h6 class="fw-bold">Đối tượng thích hợp</h6>
                            <p class="text-muted small mb-0">Gia đình, Bạn bè</p>
                        </div>
                        <div class="col-md-4">
                            <i class="fas fa-tags fa-2x text-primary mb-2"></i>
                            <h6 class="fw-bold">Khuyến mãi</h6>
                            <p class="text-muted small mb-0">@(Model.DiscountPrice.HasValue ? "Đã bao gồm trong giá" : "Chưa có")</p>
                        </div>
                    </div>
                </div>

                <!-- Tab Lịch Khởi Hành -->
                <div class="tab-pane fade panel-card p-4 border-0 mb-4" id="calendar" role="tabpanel" style="border-radius: var(--radius);">
                    <h5 class="fw-bold text-center text-uppercase mb-3">Lịch Khởi Hành</h5>
                    
                    @if (Model.DepartureDate.HasValue)
                    {
                        <div class="d-flex flex-column flex-md-row gap-3">
                            <!-- Sidebar Chọn Tháng -->
                            <div class="month-selector border-end pe-md-3" style="min-width: 95px;">
                                <div class="text-center fw-bold mb-2" style="color: #666; font-size: 0.75rem;">Chọn tháng</div>
                                @{
                                    var currentMonth = DateTime.Now;
                                    for (int i = 0; i < 5; i++)
                                    {
                                        var monthDate = currentMonth.AddMonths(i);
                                        var monthStr = monthDate.ToString("M/yyyy");
                                        <button class="btn w-100 mb-1 fw-bold month-btn @(i == 0 ? "btn-primary active-month" : "btn-light text-primary")" onclick="changeMonth(this)" data-month="@monthDate.Month" data-year="@monthDate.Year">@monthStr</button>
                                    }
                                }
                            </div>

                            <!-- Bàn Cờ Lịch (nhỏ gọn) -->
                            <div class="calendar-grid flex-grow-1">
                                <div class="d-flex justify-content-center align-items-center mb-2">
                                    <h6 class="fw-bold text-primary mb-0" id="current-month-display">THÁNG @currentMonth.ToString("M/yyyy")</h6>
                                </div>

                                <table class="table table-borderless text-center calendar-table mb-0" style="table-layout: fixed;">
                                    <thead>
                                        <tr style="font-weight: bold; color: #333;">
                                            <th class="py-1">T2</th><th class="py-1">T3</th><th class="py-1">T4</th>
                                            <th class="py-1">T5</th><th class="py-1">T6</th><th class="py-1 text-danger">T7</th><th class="py-1 text-danger">CN</th>
                                        </tr>
                                    </thead>
                                    <tbody id="calendar-body">
                                        <!-- JS sẽ render lưới lịch tại đây -->
                                    </tbody>
                                </table>
                                <div class="text-center mt-2 small text-muted fst-italic">
                                    * Chỉ hiện ngày có lịch khởi hành từ hệ thống.
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <p class="text-muted fs-6">Chưa có lịch khởi hành cho tour này.<br/>Vui lòng liên hệ Hotline để được hỗ trợ.</p>
                        </div>
                    }
                </div>

                <!-- Tab Lịch Trình -->
                <div class="tab-pane fade panel-card p-4 border-0 mb-4" id="schedule" role="tabpanel" style="border-radius: var(--radius);">
                    <h5 class="fw-bold text-uppercase mb-4">Lịch trình chi tiết</h5>
                    @if (!string.IsNullOrEmpty(Model.Schedule))
                    {
                        <div class="accordion" id="tourSchedule">
                            @{
                                var lines = Model.Schedule.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                                var dayIndex = 1;
                                string currentHeader = "";
                                List<string> currentBody = new List<string>();

                                for (int i = 0; i < lines.Length; i++)
                                {
                                    var line = lines[i].Trim();
                                    if (line.StartsWith("Ngày ", StringComparison.OrdinalIgnoreCase) || line.StartsWith("Day ", StringComparison.OrdinalIgnoreCase))
                                    {
                                        if (!string.IsNullOrEmpty(currentHeader))
                                        {
                                            <div class="accordion-item border-0 mb-3 bg-light" style="border-radius: 8px; overflow: hidden;">
                                                <h2 class="accordion-header" id="heading_@dayIndex">
                                                    <button class="accordion-button @(dayIndex == 1 ? "" : "collapsed") bg-transparent text-dark fw-bold border-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@dayIndex" aria-expanded="@(dayIndex == 1 ? "true" : "false")">
                                                        @currentHeader
                                                    </button>
                                                </h2>
                                                <div id="collapse_@dayIndex" class="accordion-collapse collapse @(dayIndex == 1 ? "show" : "")" data-bs-parent="#tourSchedule">
                                                    <div class="accordion-body bg-white border-top">
                                                        @Html.Raw(string.Join("<br/>", currentBody))
                                                    </div>
                                                </div>
                                            </div>
                                            dayIndex++;
                                        }
                                        currentHeader = line;
                                        currentBody.Clear();
                                    }
                                    else
                                    {
                                        currentBody.Add(line);
                                    }
                                }
                                if (!string.IsNullOrEmpty(currentHeader))
                                {
                                    <div class="accordion-item border-0 mb-3 bg-light" style="border-radius: 8px; overflow: hidden;">
                                        <h2 class="accordion-header" id="heading_end">
                                            <button class="accordion-button collapsed bg-transparent text-dark fw-bold border-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_end" aria-expanded="false">
                                                @currentHeader
                                            </button>
                                        </h2>
                                        <div id="collapse_end" class="accordion-collapse collapse" data-bs-parent="#tourSchedule">
                                            <div class="accordion-body bg-white border-top">
                                                @Html.Raw(string.Join("<br/>", currentBody))
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (lines.Length > 0 && dayIndex == 1)
                                {
                                    <div>@Html.Raw(Model.Schedule.Replace("\n", "<br/>"))</div>
                                }
                            }
                        </div>
                    }
                    else { <p class="text-muted">Đang cập nhật lịch trình...</p> }
                </div>

                <!-- Tab Lưu Ý -->
                <div class="tab-pane fade panel-card p-4 border-0 mb-4" id="notes" role="tabpanel" style="border-radius: var(--radius);">
                    <h5 class="fw-bold mb-3">Lưu ý khi đặt tour</h5>
                    <ul class="text-muted" style="line-height: 1.8;">
                        <li>Giá tour có thể thay đổi vào các dịp Lễ, Tết.</li>
                        <li>Trẻ em dưới 2 tuổi miễn phí nhưng vẫn thu phụ phí bảo hiểm/vé máy bay theo quy định.</li>
                        <li>Trẻ em từ 5 - 11 tuổi tính 50% giá tour (ngủ chung với cha mẹ).</li>
                        <li>Hủy tour trước 7 ngày khởi hành được hoàn 100% chi phí.</li>
                        <li>Nếu đi nhóm trên 10 người, vui lòng liên hệ trực tiếp để có giá ưu đãi.</li>
                    </ul>
                </div>

                <!-- Tab Đánh Giá -->
                <div class="tab-pane fade panel-card p-4 border-0 mb-4" id="reviews" role="tabpanel" style="border-radius: var(--radius);">
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                        <h5 class="fw-bold mb-0">Đánh giá từ khách hàng</h5>
                        @if (Model.Reviews != null && Model.Reviews.Any())
                        {
                            <div class="d-flex align-items-center">
                                <h3 class="fw-bold text-warning mb-0 me-2">@Math.Round(Model.Reviews.Average(r => r.Rating), 1)</h3>
                                <div class="text-warning me-2">
                                    <i class="fas fa-star"></i>
                                </div>
                                <span class="text-muted small">(@Model.Reviews.Count đánh giá)</span>
                            </div>
                        }
                    </div>

                    @if (Model.Reviews != null && Model.Reviews.Any())
                    {
                        <div class="review-list mt-3">
                            @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt).Take(10))
                            {
                                <div class="card border-0 bg-light bg-opacity-50 mb-3" style="border-radius: 12px;">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-secondary bg-opacity-25 rounded-circle d-flex justify-content-center align-items-center text-secondary fw-bold me-2" style="width: 36px; height: 36px;">
                                                    @((review.User?.FullName ?? "K")[0])
                                                </div>
                                                <div>
                                                    <div class="fw-bold fs-6">@(review.User?.FullName ?? "Khách")</div>
                                                    <div class="text-muted" style="font-size: 0.75rem;">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                                </div>
                                            </div>
                                            <div class="text-warning">
                                                @for (int i = 0; i < review.Rating; i++) { <i class="fas fa-star text-warning"></i> }
                                                @for (int i = review.Rating; i < 5; i++) { <i class="far fa-star text-warning"></i> }
                                            </div>
                                        </div>
                                        <div class="text-dark">@review.Comment</div>
                                        @if (review.ImageUrls != null && review.ImageUrls.Any())
                                        {
                                            <div class="d-flex gap-2 mt-2 flex-wrap">
                                                @foreach (var img in review.ImageUrls)
                                                {
                                                    <img src="@img" class="rounded" style="width: 60px; height: 60px; object-fit: cover; cursor: pointer;" alt="Review Image" onclick="window.open(this.src, '_blank')" />
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (Model.Reviews.Count > 10)
                            {
                                <div class="text-center mt-3">
                                    <a href="@Url.Action("TourReviews", "Review", new { tourId = Model.Id })" class="btn btn-outline-primary btn-sm rounded-pill px-4">Xem tất cả @Model.Reviews.Count đánh giá</a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-comment-dots fa-3x text-muted mb-3 opacity-50"></i>
                            <h6 class="text-muted">Chưa có đánh giá nào cho chuyến đi này!</h6>
                            <p class="text-muted small">Khách hàng sẽ có thể đánh giá sau khi hoàn thành chuyến đi.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Booking Sidebar -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top panel-card right-booking-sidebar" style="top: 100px; border-radius: 12px; transition: all 0.3s ease;">
                
                <!-- VIEW 1: TRẠNG THÁI MẶC ĐỊNH CHƯA CHỌN NGÀY -->
                <div id="sidebar-unselected" class="p-4 text-center">
                    <div style="font-size: 1.1rem; color: #333; font-weight: 600; text-align: left; margin-bottom: 0.5rem;">Giá từ:</div>
                    <div class="display-6 fw-bold mb-3 d-flex align-items-baseline" style="color: #dc3545;">
                        @Model.DisplayPrice.ToString("N0") <span class="fs-5 ms-1 text-decoration-underline">đ</span> <span class="fs-6 text-dark ms-2 fw-normal">/ Khách</span>
                    </div>
                    
                    <div class="text-start mb-4">
                        <!-- Nơi này trước đây hiển thị mã tour, nay ẩn đi đối với KH -->
                    </div>

                    @if (Model.AvailableSlots <= 0)
                    {
                        <button type="button" class="btn w-100 py-3 fw-bold text-white fs-5 disabled" style="background-color: #6c757d; border-radius: 8px; cursor: not-allowed; pointer-events: none;">
                            <i class="fas fa-ban me-2"></i> Đã hết chỗ
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn w-100 py-3 fw-bold text-white fs-5" style="background-color: #1a56ad; border-radius: 8px;" onclick="scrollToCalendar()">
                            <i class="fas fa-calendar-alt me-2"></i> Chọn ngày khởi hành
                        </button>
                    }
                </div>

                <!-- VIEW 2: TRẠNG THÁI ĐÃ CHỌN NGÀY LỊCH TRÌNH -->
                <div id="sidebar-selected" class="p-4 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <button type="button" class="btn btn-link text-dark text-decoration-none px-0" onclick="resetSidebar()"><i class="fas fa-arrow-left me-1"></i> Quay lại</button>
                        <h4 class="fw-bold text-danger mb-0" id="sb-selected-date">02/04/2026</h4>
                    </div>

                    <h6 class="text-primary fw-bold text-center mb-3">Phương tiện di chuyển</h6>
                    @{
                        // Thuật toán tính toán thời gian di chuyển logic, dựa vào Id tour để cố định thông tin
                        int travelHours = 2 + (Model.Id % 6); // Thời gian chạy từ 2 - 7 tiếng
                        int depHour = 5 + (Model.Id % 4);     // Bắt đầu đi từ 5:00 - 8:00 sáng
                        int depMinute = (Model.Id % 2 == 0) ? 0 : 30; // Phút: 00 hoặc 30
                        
                        DateTime timeGoStart = new DateTime(2000, 1, 1, depHour, depMinute, 0);
                        DateTime timeGoEnd = timeGoStart.AddHours(travelHours);

                        DateTime timeReturnStart;
                        if (Model.Duration <= 1) {
                            // Nếu là tour đi về trong ngày, giờ lên xe về phải sau giờ đến nơi ít nhất 5-6 tiếng
                            timeReturnStart = timeGoEnd.AddHours(5 + (Model.Id % 3)); 
                        } else {
                            // Nếu qua ngày khác, thường sẽ trả phòng và đi về tầm 13h - 15h chiều
                            timeReturnStart = new DateTime(2000, 1, 1, 13 + (Model.Id % 3), depMinute, 0); 
                        }
                        DateTime timeReturnEnd = timeReturnStart.AddHours(travelHours);
                        
                        string transitIcon = (Model.Transportation != null && Model.Transportation.Contains("Máy bay")) ? "fa-plane" : "fa-bus";
                    }

                    <div class="d-flex justify-content-between mb-4" style="font-size: 0.9rem;">
                        <div style="width: 45%;">
                            <div class="fw-bold mb-1">Ngày đi - <span id="sb-start-date"></span></div>
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-1">
                                <span class="fw-bold">@timeGoStart.ToString("HH:mm")</span>
                                <i class="fas @transitIcon text-muted"></i>
                                <span class="fw-bold">@timeGoEnd.ToString("HH:mm")</span>
                            </div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span class="text-truncate" style="max-width: 45%;">@Model.DepartureLocation</span>
                                <span class="text-truncate text-end" style="max-width: 45%;">@Model.Destination</span>
                            </div>
                        </div>
                        <div style="width: 45%;">
                            <div class="fw-bold mb-1">Ngày về - <span id="sb-end-date"></span></div>
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-1">
                                <span class="fw-bold">@timeReturnStart.ToString("HH:mm")</span>
                                <i class="fas @transitIcon text-muted"></i>
                                <span class="fw-bold">
                                    @timeReturnEnd.ToString("HH:mm")
                                    @if(timeReturnEnd.Day > timeReturnStart.Day) { <span class="text-danger small" style="font-size: 0.7rem;">(+1)</span> }
                                </span>
                            </div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span class="text-truncate" style="max-width: 45%;">@Model.Destination</span>
                                <span class="text-truncate text-end" style="max-width: 45%;">@Model.DepartureLocation</span>
                            </div>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25" />

                    <h6 class="text-primary fw-bold text-center mb-3">Giá</h6>
                    <div class="row g-3 fs-6 mb-4 border-bottom pb-3">
                        <div class="col-6">
                            <div class="fw-bold">Người lớn</div>
                            <div class="small text-muted mb-1">(Từ 12 tuổi trở lên)</div>
                            <div class="text-danger fw-bold fs-5">@Model.DisplayPrice.ToString("N0") đ</div>
                        </div>
                        <div class="col-6">
                            <div class="fw-bold">Trẻ nhỏ</div>
                            <div class="small text-muted mb-1">(Từ 5 - 11 tuổi)</div>
                            <div class="text-danger fw-bold fs-5">@((Model.DisplayPrice / 2).ToString("N0")) đ</div>
                        </div>
                    </div>

                    <div class="bg-info bg-opacity-10 text-primary p-3 rounded mb-4" style="font-size: 0.85rem;">
                        <i class="fas fa-headset me-1"></i> Hỗ trợ đặt tour & tư vấn miễn phí:<br/>
                        <strong>Hotline: 038 535 3174 (08:00 - 22:00)</strong>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger fw-bold" onclick="resetSidebar()" style="white-space: nowrap;">Ngày khác</button>
                        <a href="@Url.Action("Book", "Tour", new { id = Model.Id })" id="btn-submit-booking" class="btn w-100 fw-bold text-white shadow-sm" style="background-color: #e02000;">
                            Đặt ngay
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Related Tours -->
    @if (relatedTours.Any())
    {
        <section class="mt-5 section-shell" data-reveal="up">
            <h3 class="fw-bold mb-4 text-center text-uppercase">Chương trình khác</h3>
            <div class="row g-4">
                @foreach (var tour in relatedTours)
                {
                    <div class="col-md-6 col-lg-3" data-reveal="up">
                        <partial name="_TourCardPartial" model="tour" />
                    </div>
                }
            </div>
        </section>
    }
</div>

<style>
    .tour-tab-btn { background: transparent !important; border-radius: 0 !important; color: #555; }
    .tour-tab-btn.active { color: #1a56ad !important; border-bottom: 3px solid #1a56ad !important; }
    
    .calendar-cell { height: 48px; vertical-align: middle; border: 1px solid transparent; border-radius: 6px; transition: all 0.15s ease; position: relative; font-size: 0.8rem; }
    .calendar-cell.has-tour { background-color: #eef6ff; cursor: pointer; border: 1px solid #c5ddf8; }
    .calendar-cell.has-tour:hover { background-color: #d0e8ff; border-color: #1a56ad; transform: scale(1.05); }
    .calendar-cell.selected { border-color: #dc3545 !important; background-color: #fff5f5 !important; box-shadow: 0 2px 8px rgba(220,53,69,0.2); z-index: 10; transform: scale(1.08); }
    .calendar-cell.empty-day { color: #d0d0d0; }
    
    .month-btn { text-align: center; border-radius: 6px; transition: all 0.2s; border: none; font-size: 0.78rem; padding: 5px 6px; }
    .month-btn:hover:not(.active-month) { background-color: #e9ecef !important; }
    .active-month { background-color: #1a56ad !important; color: white !important; box-shadow: 0 3px 8px rgba(26,86,173,0.3); }

    .calendar-table { font-size: 0.8rem; }
    .calendar-table th { font-size: 0.72rem; padding: 3px 2px !important; }
    .calendar-table td { padding: 2px !important; }
</style>

<script>
    const GIA_MOC = @Model.DisplayPrice;
    const TOUR_DEPARTURE_DATE = @(Model.DepartureDate.HasValue ? $"new Date({Model.DepartureDate.Value.Year}, {Model.DepartureDate.Value.Month - 1}, {Model.DepartureDate.Value.Day})" : "null");
    
    function scrollToCalendar() {
        var triggerEl = document.querySelector('#calendar-tab');
        var tab = new bootstrap.Tab(triggerEl);
        tab.show();
        triggerEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function resetSidebar() {
        document.getElementById('sidebar-selected').classList.add('d-none');
        document.getElementById('sidebar-unselected').classList.remove('d-none');
        document.querySelectorAll('.calendar-cell').forEach(c => c.classList.remove('selected'));
    }

    function changeMonth(btn) {
        document.querySelectorAll('.month-btn').forEach(b => {
             b.classList.remove('btn-primary', 'active-month');
             b.classList.add('btn-light', 'text-primary');
        });
        btn.classList.remove('btn-light', 'text-primary');
        btn.classList.add('btn-primary', 'active-month');
        
        var month = btn.getAttribute('data-month');
        var year = btn.getAttribute('data-year');
        document.getElementById('current-month-display').innerText = `THÁNG ${month}/${year}`;
        
        generateCalendar(year, month);
    }

    function generateCalendar(year, month) {
        const tbody = document.getElementById('calendar-body');
        if (!tbody) return;
        tbody.innerHTML = '';
        
        const firstDay = new Date(year, month - 1, 1);
        const lastDay = new Date(year, month, 0).getDate();
        let startDayOfWeek = firstDay.getDay() === 0 ? 6 : firstDay.getDay() - 1;
        
        let date = 1;
        for (let i = 0; i < 6; i++) {
            let row = document.createElement('tr');
            for (let j = 0; j < 7; j++) {
                let cell = document.createElement('td');
                cell.className = 'calendar-cell p-0';
                
                if (i === 0 && j < startDayOfWeek) {
                    // Ô trống
                } else if (date > lastDay) {
                    // Hết ngày
                } else {
                    let fullDateStr = `${year}-${String(month).padStart(2,'0')}-${String(date).padStart(2,'0')}`;
                    let dateDisplayStr = `${String(date).padStart(2,'0')}/${String(month).padStart(2,'0')}/${year}`;
                    
                    let isTourDate = false;
                    if (TOUR_DEPARTURE_DATE) {
                        isTourDate = (TOUR_DEPARTURE_DATE.getFullYear() == year 
                                   && (TOUR_DEPARTURE_DATE.getMonth() + 1) == month 
                                   && TOUR_DEPARTURE_DATE.getDate() == date);
                    }
                    
                    let cellHTML = `<div class="fw-bold">${date}</div>`;
                    
                    if (isTourDate) {
                        cellHTML += `<div class="fw-bold" style="color: #dc3545; font-size: 0.65rem;">${(GIA_MOC/1000).toLocaleString('vi-VN')}K</div>`;
                        
                        var isSoldOut = @(Model.AvailableSlots <= 0 ? "true" : "false");
                        if (isSoldOut) {
                            cell.classList.add('empty-day'); // Make it look disabled like empty days
                            cellHTML += `<div class="text-muted" style="font-size: 0.6rem;">Hết chỗ</div>`;
                        } else {
                            cell.classList.add('has-tour');
                            const capturedDate = date;
                            cell.onclick = function() {
                                document.querySelectorAll('.calendar-cell').forEach(c => c.classList.remove('selected'));
                                this.classList.add('selected');
                            
                            document.getElementById('sidebar-unselected').classList.add('d-none');
                            document.getElementById('sidebar-selected').classList.remove('d-none');
                            
                            document.getElementById('sb-selected-date').innerText = dateDisplayStr;
                            document.getElementById('sb-start-date').innerText = dateDisplayStr;
                            
                            let d = new Date(year, month - 1, capturedDate);
                            d.setDate(d.getDate() + @Model.Duration - 1);
                            document.getElementById('sb-end-date').innerText = `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`;
                            
                            var baseUrl = '@Url.Action("Book", "Tour", new { id = Model.Id })';
                            document.getElementById('btn-submit-booking').href = baseUrl + '?date=' + fullDateStr;
                        };
                        } // end of isSoldOut else block
                    } else {
                        cell.classList.add('empty-day');
                    }
                    
                    cell.innerHTML = cellHTML;
                    date++;
                }
                row.appendChild(cell);
            }
            tbody.appendChild(row);
            if (date > lastDay) break;
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        // Tự động nhảy đến tháng có ngày khởi hành
        if (TOUR_DEPARTURE_DATE) {
            var depMonth = TOUR_DEPARTURE_DATE.getMonth() + 1;
            var depYear = TOUR_DEPARTURE_DATE.getFullYear();
            
            var monthBtns = document.querySelectorAll('.month-btn');
            var found = false;
            monthBtns.forEach(function(btn) {
                if (parseInt(btn.getAttribute('data-month')) === depMonth && parseInt(btn.getAttribute('data-year')) === depYear) {
                    changeMonth(btn);
                    found = true;
                }
            });
            if (!found) {
                var activeBtn = document.querySelector('.active-month');
                if (activeBtn) changeMonth(activeBtn);
            }
        } else {
            var activeMonthBtn = document.querySelector('.active-month');
            if (activeMonthBtn) changeMonth(activeMonthBtn);
        }

        document.querySelectorAll('.tour-tab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
               document.querySelectorAll('.tour-tab-btn').forEach(b => {
                   b.classList.remove('active', 'text-primary'); 
                   b.classList.add('text-dark');
                   b.style.borderBottomColor = 'transparent';
               });
               this.classList.add('active', 'text-primary');
               this.classList.remove('text-dark');
               this.style.borderBottomColor = '#1a56ad';
            });
        });
    });
</script>

