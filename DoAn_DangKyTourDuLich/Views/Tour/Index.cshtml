@model TourSearchViewModel
@{
    ViewData["Title"] = "Danh sách Tour du lịch";
}

<div class="container py-4">
    <section class="page-hero page-hero--compact mb-4" data-reveal="up">
        <div class="page-hero__content">
            <span class="page-hero__eyebrow">Khám Phá Hành Trình</span>
            <h1 class="page-hero__title mb-2">Danh Sách Tour</h1>
            <p class="page-hero__subtitle mb-0">Lọc nhanh, so sánh dễ dàng và chọn tour phù hợp cho chuyến đi tiếp theo.</p>
        </div>
    </section>

    <div class="row">
        <!-- Sidebar Filter -->
        <div class="col-lg-3 mb-4" data-reveal="left">
            <div class="filter-sidebar panel-card">
                <h5><i class="fas fa-filter me-2"></i>Bộ lọc</h5>
                <form asp-action="Index" method="get">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Từ khóa</label>
                        <input type="text" name="Keyword" value="@Model.Keyword" class="form-control form-control-sm" placeholder="Tìm kiếm..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Danh mục</label>
                        <select name="CategoryId" class="form-select form-select-sm">
                            <option value="">-- Tất cả --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Giá từ (VNĐ)</label>
                        <input type="number" name="MinPrice" value="@Model.MinPrice" class="form-control form-control-sm" placeholder="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Giá đến (VNĐ)</label>
                        <input type="number" name="MaxPrice" value="@Model.MaxPrice" class="form-control form-control-sm" placeholder="10,000,000" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Điểm đến</label>
                        <input type="text" name="Destination" value="@Model.Destination" class="form-control form-control-sm" placeholder="VD: Đà Nẵng" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Sắp xếp</label>
                        <select name="SortBy" class="form-select form-select-sm">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Mặc định</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Giá tăng dần</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Giá giảm dần</option>
                            <option value="name" selected="@(Model.SortBy == "name")">Tên A-Z</option>
                            <option value="newest" selected="@(Model.SortBy == "newest")">Mới nhất</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-sm">
                        <i class="fas fa-search me-1"></i>Lọc kết quả
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 btn-sm mt-2">
                        <i class="fas fa-redo me-1"></i>Xóa bộ lọc
                    </a>
                </form>
            </div>
        </div>

        <!-- Tour List -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3 panel-strip" data-reveal="up">
                <h4 class="fw-bold mb-0">
                    <i class="fas fa-map-marked-alt me-2 text-primary"></i>Tour Du Lịch
                </h4>
                <span class="text-muted">Tìm thấy <strong>@Model.TotalItems</strong> tour</span>
            </div>

            @if (!Model.Tours.Any())
            {
                <div class="text-center py-5 empty-state panel-card" data-reveal="up">
                    <i class="fas fa-search fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">Không tìm thấy tour nào phù hợp</h5>
                    <p class="text-muted">Hãy thử thay đổi bộ lọc của bạn</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var tour in Model.Tours)
                    {
                        <div class="col-md-6 col-lg-4" data-reveal="up">
                            <div class="tour-card card">
                                <div class="card-img-wrapper">
                                    @if (!string.IsNullOrEmpty(tour.ImageUrl))
                                    {
                                        <img src="@tour.ImageUrl" class="card-img-top" alt="@tour.Name" />
                                    }
                                    else
                                    {
                                        <div class="tour-img-placeholder"><i class="fas fa-image"></i></div>
                                    }
                                    @if (tour.IsFeatured)
                                    {
                                        <span class="card-badge badge badge-featured"><i class="fas fa-star me-1"></i>Nổi bật</span>
                                    }
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <div class="tour-info mb-2">
                                        <span class="me-3"><i class="fas fa-map-marker-alt text-danger me-1"></i>@tour.Destination</span>
                                        <span><i class="fas fa-clock text-primary me-1"></i>@tour.Duration ngày</span>
                                    </div>
                                    <h6 class="tour-title">
                                        <a asp-action="Details" asp-route-id="@tour.Id" class="text-decoration-none text-dark">@tour.Name</a>
                                    </h6>
                                    <p class="tour-desc">@tour.ShortDescription</p>
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                @if (tour.DiscountPrice.HasValue)
                                                {
                                                    <span class="tour-price-old">@tour.Price.ToString("N0")đ</span><br />
                                                }
                                                <span class="tour-price">@tour.DisplayPrice.ToString("N0")đ</span>
                                            </div>
                                            <a asp-action="Details" asp-route-id="@tour.Id" class="btn btn-primary btn-sm">
                                                Chi tiết <i class="fas fa-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                        <div class="mt-2">
                                            <small class="text-muted">
                                                <i class="fas fa-users me-1"></i>Còn @tour.AvailableSlots chỗ
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4" data-reveal="up">
                        <ul class="pagination justify-content-center">
                            @if (Model.Page > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-Page="@(Model.Page - 1)" asp-route-Keyword="@Model.Keyword" asp-route-CategoryId="@Model.CategoryId" asp-route-SortBy="@Model.SortBy">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-Page="@i" asp-route-Keyword="@Model.Keyword" asp-route-CategoryId="@Model.CategoryId" asp-route-SortBy="@Model.SortBy">@i</a>
                                </li>
                            }
                            @if (Model.Page < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-Page="@(Model.Page + 1)" asp-route-Keyword="@Model.Keyword" asp-route-CategoryId="@Model.CategoryId" asp-route-SortBy="@Model.SortBy">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
