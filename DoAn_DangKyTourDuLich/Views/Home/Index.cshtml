@{
    ViewData["Title"] = "Trang chủ";
    var featuredTours = ViewBag.FeaturedTours as List<Tour> ?? new List<Tour>();
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var latestTours = ViewBag.LatestTours as List<Tour> ?? new List<Tour>();
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-orb hero-orb--one"></div>
    <div class="hero-orb hero-orb--two"></div>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 fade-in-up" data-reveal="left">
                <h1>Khám Phá Việt Nam<br/>Cùng Chúng Tôi</h1>
                <p class="lead mb-4">Đặt tour du lịch trực tuyến nhanh chóng, an toàn. Hàng trăm tour hấp dẫn đang chờ bạn khám phá!</p>
                <a asp-controller="Tour" asp-action="Index" class="btn btn-lg btn-secondary-custom me-3">
                    <i class="fas fa-search me-2"></i>Xem tất cả Tour
                </a>
            </div>
            <div class="col-lg-5 mt-4 mt-lg-0">
                <div class="search-box fade-in-up glass-panel" data-reveal="right">
                    <h5 class="text-white mb-3"><i class="fas fa-search me-2"></i>Tìm kiếm Tour</h5>
                    <form asp-controller="Tour" asp-action="Index" method="get">
                        <div class="mb-3 position-relative">
                            <input type="text"
                                   name="Keyword"
                                   class="form-control tour-autocomplete-input"
                                   placeholder="Nhập điểm đến, tên tour..."
                                   autocomplete="off"
                                   data-suggest-url="@Url.Action("Suggestions", "Tour")" />
                            <div class="tour-autocomplete-list"></div>
                        </div>
                        <div class="mb-3">
                            <select name="CategoryId" class="form-select">
                                <option value="">-- Tất cả danh mục --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-secondary-custom w-100">
                            <i class="fas fa-search me-2"></i>Tìm kiếm
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .tour-autocomplete-list {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        z-index: 30;
        display: none;
        padding: 8px;
        background: #fff;
        border-radius: 18px;
        border: 1px solid rgba(37, 99, 235, 0.15);
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.18);
    }

    .tour-autocomplete-list.is-open {
        display: block;
    }

    .tour-autocomplete-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
        padding: 10px 12px;
        border: 0;
        border-radius: 12px;
        background: transparent;
        text-align: left;
        transition: background-color 0.2s ease;
    }

    .tour-autocomplete-item:hover,
    .tour-autocomplete-item.is-active {
        background: #eff6ff;
    }

    .tour-autocomplete-type {
        color: #2563eb;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* Category Glassmorphism Cards */
    .category-glass-card {
        transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s ease;
    }
    .category-glass-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0) 100%);
        z-index: 1;
        transition: opacity 0.4s ease, background 0.4s ease;
    }
    .category-glass-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 40px rgba(0,0,0,0.2) !important;
    }
    .category-glass-card:hover::before {
        opacity: 0.9;
        background: linear-gradient(to top, rgba(26,115,232,0.85) 0%, rgba(0,0,0,0.2) 100%);
    }
    .glass-overlay {
        z-index: 2;
    }
    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.4);
        transition: transform 0.3s ease, background 0.3s ease;
    }
    .category-glass-card:hover .icon-circle {
        transform: scale(1.1) rotate(10deg);
        background: var(--accent);
        border-color: var(--accent);
    }
    .shadow-text {
        text-shadow: 0 4px 12px rgba(0,0,0,0.6);
        transition: transform 0.3s ease;
    }
    .category-glass-card:hover .shadow-text {
        transform: translateY(-2px);
    }
</style>

<script>
    (() => {
        const inputs = document.querySelectorAll('.tour-autocomplete-input');

        inputs.forEach((input) => {
            const wrapper = input.closest('.position-relative');
            const list = wrapper?.querySelector('.tour-autocomplete-list');
            const suggestUrl = input.dataset.suggestUrl;

            if (!list || !suggestUrl) {
                return;
            }

            let items = [];
            let activeIndex = -1;
            let debounceId;

            const closeList = () => {
                list.classList.remove('is-open');
                list.innerHTML = '';
                items = [];
                activeIndex = -1;
            };

            const renderItems = (suggestions) => {
                if (!suggestions.length) {
                    closeList();
                    return;
                }

                list.innerHTML = suggestions.map((item, index) => `
                    <button type="button" class="tour-autocomplete-item${index === 0 ? ' is-active' : ''}" data-value="${item.text}">
                        <span>${item.text}</span>
                        <span class="tour-autocomplete-type">${item.type}</span>
                    </button>
                `).join('');

                items = Array.from(list.querySelectorAll('.tour-autocomplete-item'));
                activeIndex = 0;
                list.classList.add('is-open');

                items.forEach((item) => {
                    item.addEventListener('mousedown', (event) => {
                        event.preventDefault();
                        input.value = item.dataset.value || '';
                        closeList();
                    });
                });
            };

            const setActive = (index) => {
                if (!items.length) {
                    return;
                }

                activeIndex = (index + items.length) % items.length;
                items.forEach((item, itemIndex) => {
                    item.classList.toggle('is-active', itemIndex === activeIndex);
                });
            };

            input.addEventListener('input', () => {
                const term = input.value.trim();
                clearTimeout(debounceId);

                if (term.length < 1) {
                    closeList();
                    return;
                }

                debounceId = setTimeout(async () => {
                    try {
                        const response = await fetch(`${suggestUrl}?term=${encodeURIComponent(term)}`);
                        if (!response.ok) {
                            closeList();
                            return;
                        }

                        renderItems(await response.json());
                    } catch {
                        closeList();
                    }
                }, 180);
            });

            input.addEventListener('keydown', (event) => {
                if (!list.classList.contains('is-open')) {
                    return;
                }

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    setActive(activeIndex + 1);
                } else if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    setActive(activeIndex - 1);
                } else if (event.key === 'Enter' && activeIndex >= 0 && items[activeIndex]) {
                    event.preventDefault();
                    input.value = items[activeIndex].dataset.value || '';
                    closeList();
                    input.form?.submit();
                } else if (event.key === 'Escape') {
                    closeList();
                }
            });

            input.addEventListener('blur', () => {
                window.setTimeout(closeList, 120);
            });
        });
    })();
</script>

<!-- Categories Section -->
@if (categories.Any())
{
    <section class="py-5 section-shell bg-light">
        <div class="container">
            <div class="text-center mb-5" data-reveal="up">
                <h2 class="section-title">Khám Phá Qua Câu Chuyện</h2>
                <p class="section-subtitle">Mỗi danh mục là một màu sắc khác biệt cho chuyến hành trình của bạn</p>
            </div>
            <div class="row g-4 justify-content-center">
                @{
                    var icons = new[] { "fa-spa", "fa-plane-departure", "fa-users-viewfinder", "fa-person-hiking", "fa-utensils" };
                }
                @for (int i = 0; i < categories.Count; i++)
                {
                    var cat = categories[i];
                    var icon = i < icons.Length ? icons[i] : "fa-compass";
                    <div class="col-12 col-sm-6 col-lg" data-reveal="up" style="transition-delay: @(i * 100)ms">
                        <a asp-controller="Tour" asp-action="Index" asp-route-CategoryId="@cat.Id" class="text-decoration-none d-block h-100">
                            <div class="category-glass-card h-100 position-relative overflow-hidden rounded-4 shadow-sm" style="background-image: url('@cat.ImageUrl'); background-size: cover; background-position: center; min-height: 280px;">
                                <div class="glass-overlay d-flex flex-column justify-content-end p-4 h-100 w-100 position-absolute top-0 start-0">
                                    <div class="icon-circle mb-3">
                                        <i class="fas @icon text-white fs-4"></i>
                                    </div>
                                    <h5 class="fw-bold text-white mb-1 shadow-text">@cat.Name</h5>
                                    <span class="badge bg-white text-primary fw-bold px-3 py-2 mt-2 align-self-start shadow-sm" style="border-radius: 20px;">
                                        @(cat.Tours?.Count ?? 0) Tour
                                    </span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Featured Tours Section -->
@if (featuredTours.Any())
{
    <section class="py-5 bg-white section-shell">
        <div class="container">
            <div class="text-center mb-4" data-reveal="up">
                <h2 class="section-title">Tour Nổi Bật</h2>
                <p class="section-subtitle">Những tour du lịch được yêu thích nhất</p>
            </div>
            <div class="row g-4">
                @foreach (var tour in featuredTours)
                {
                    <div class="col-md-6 col-lg-4" data-reveal="up">
                        <partial name="_TourCardPartial" model="tour" />
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a asp-controller="Tour" asp-action="Index" class="btn btn-outline-primary btn-lg">
                    Xem tất cả Tour <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- Why Choose Us -->
