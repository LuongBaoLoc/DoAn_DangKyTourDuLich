<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tour Du Lịch Online</title>
    <meta name="description" content="Website đăng ký và kinh doanh tour du lịch trực tuyến" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary-gradient sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fas fa-globe-asia me-2"></i>Tour Du Lịch
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home me-1"></i>Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Tour" asp-action="Index">
                            <i class="fas fa-map-marked-alt me-1"></i>Tour du lịch
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>Quản trị
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                <li>
                                    <a class="dropdown-item" asp-controller="Tour" asp-action="MyOrders">
                                        <i class="fas fa-clipboard-list me-2"></i>Đơn hàng của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="fas fa-user me-2"></i>Tài khoản
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-1"></i>Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm ms-2 mt-1" asp-controller="Account" asp-action="Register">
                                <i class="fas fa-user-plus me-1"></i>Đăng ký
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Toast Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
            <div class="toast show align-items-center text-bg-success border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
            <div class="toast show align-items-center text-bg-danger border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="fas fa-globe-asia me-2"></i>Tour Du Lịch</h5>
                    <p class="text-white-50">Website đăng ký và kinh doanh tour du lịch trực tuyến. Khám phá những điểm đến tuyệt vời cùng chúng tôi.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3">Liên kết nhanh</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/" class="text-white-50 text-decoration-none"><i class="fas fa-chevron-right me-2"></i>Trang chủ</a></li>
                        <li class="mb-2"><a asp-controller="Tour" asp-action="Index" class="text-white-50 text-decoration-none"><i class="fas fa-chevron-right me-2"></i>Tour du lịch</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none"><i class="fas fa-chevron-right me-2"></i>Chính sách</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3">Liên hệ</h5>
                    <ul class="list-unstyled text-white-50">
                        <li class="mb-2"><i class="fas fa-map-marker-alt me-2"></i>Tịnh Biên, An Giang, Việt Nam</li>
                        <li class="mb-2"><i class="fas fa-phone me-2"></i>0385353174</li>
                        <li class="mb-2"><i class="fas fa-envelope me-2"></i>luongbaoloc2014@gmail.com</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary" />
            <div class="text-center text-white-50">
                <p class="mb-0">&copy; 2026 Tour Du Lịch Online. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <div class="floating-contact is-collapsed" data-floating-contact>
        <div class="floating-contact__items">
            <a class="floating-contact__link floating-contact__link--facebook"
               href="https://www.facebook.com/LuongBaoLoc2K5?locale=vi_VN"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Liên hệ Facebook">
                <i class="fab fa-facebook-f" aria-hidden="true"></i>
            </a>
            <a class="floating-contact__link floating-contact__link--zalo"
               href="https://zalo.me/0385353174"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Liên hệ Zalo">
                <span>Zalo</span>
            </a>
        </div>
        <button type="button"
                class="floating-contact__toggle"
                data-floating-contact-toggle
                aria-expanded="false"
                aria-label="Đóng mở liên hệ nhanh">
            <i class="fas fa-xmark" aria-hidden="true"></i>
        </button>
        <span class="floating-contact__dot" aria-hidden="true"></span>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/falling-petals.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Auto-hide toasts after 4 seconds
        setTimeout(function() {
            var toasts = document.querySelectorAll('.toast.show');
            toasts.forEach(function(toast) {
                var bsToast = new bootstrap.Toast(toast);
                bsToast.hide();
            });
        }, 4000);
    </script>
</body>
</html>
