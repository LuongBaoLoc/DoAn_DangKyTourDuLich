@model Tour

<div class="tour-card card h-100">
    <div class="card-img-wrapper position-relative">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="height: 200px; object-fit: cover;" />
        }
        else
        {
            <div class="tour-img-placeholder d-flex justify-content-center align-items-center" style="height: 200px; background-color: #f8f9fa;">
                <i class="fas fa-image text-muted fa-3x"></i>
            </div>
        }
        @if (Model.IsFeatured)
        {
            <span class="card-badge badge badge-featured"><i class="fas fa-star me-1"></i>Nổi bật</span>
        }
    </div>
    <div class="card-body d-flex flex-column" style="padding: 1rem;">
        <h6 class="tour-title mb-3" style="font-size: 1.15rem; font-weight: 700; color: #333; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8rem;">
            <a asp-controller="Tour" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark" title="@Model.Name">@Model.Name</a>
        </h6>

        <div class="row g-2 mb-3" style="font-size: 0.9rem; color: #444;">
            <div class="col-6 d-flex align-items-center">
                <i class="fas fa-ticket-alt text-secondary me-2" style="width: 16px; text-align: center;"></i>
                <span class="text-truncate">Mã tour: <strong>TOUR@(Model.Id.ToString("D4"))</strong></span>
            </div>
            <div class="col-6 d-flex align-items-center">
                <i class="fas fa-map-marker-alt text-secondary me-2" style="width: 16px; text-align: center;"></i>
                <span class="text-truncate">Khởi hành: <strong>@Model.DepartureLocation</strong></span>
            </div>
            <div class="col-6 d-flex align-items-center">
                <i class="fas fa-clock text-secondary me-2" style="width: 16px; text-align: center;"></i>
                <span class="text-truncate">Thời gian: <strong>@Model.Duration ngày</strong></span>
            </div>
            <div class="col-6 d-flex align-items-center">
                <i class="fas fa-bus text-secondary me-2" style="width: 16px; text-align: center;"></i>
                <span class="text-truncate">Phương tiện: <strong>@(Model.Transportation ?? "Xe")</strong></span>
            </div>
        </div>

        <div class="departure-dates-wrapper d-flex align-items-center mb-3">
            <div class="d-flex align-items-center me-2 text-nowrap">
                <i class="fas fa-calendar-alt text-secondary me-2" style="font-size: 1.1rem;"></i>
                <span style="font-size: 0.95rem;">Ngày khởi hành:</span>
            </div>
            <div class="position-relative flex-grow-1" style="min-width: 0;">
                <button type="button" class="btn btn-sm btn-link text-muted px-1 departure-date-nav btn-prev position-absolute start-0 top-50 translate-middle-y z-1 bg-white border-0" style="left: -5px !important;" onclick="scrollDates(this, -100)">
                    <i class="fas fa-arrow-left"></i>
                </button>
                <div class="departure-dates-container d-flex overflow-hidden mx-4 position-relative px-1" style="scroll-behavior: smooth;" onmousewheel="event.preventDefault(); this.scrollLeft += event.deltaY;">
                    @{
                        var departureDate = Model.DepartureDate ?? DateTime.Today.AddDays(2);
                        for (int i = 0; i < 7; i++)
                        {
                            var date = departureDate.AddDays(i * (i % 2 == 0 ? 2 : 3)); // Generate random future dates like the image
                            var isSelected = (i == 0) ? "active-date" : "";
                            <a href="@Url.Action("Details", "Tour", new { id = Model.Id, date = date.ToString("yyyy-MM-dd") })"
                               class="departure-date-item text-decoration-none bg-white d-inline-block text-center rounded-1 @isSelected"
                               style="border: 1px solid @((i==0) ? "#dc3545" : "#ddd"); color: @((i==0) ? "#dc3545" : "#333"); padding: 3px 6px; font-size: 0.85rem; margin-right: 6px; min-width: 50px;">
                                @date.ToString("dd/MM")
                            </a>
                        }
                    }
                </div>
                <button type="button" class="btn btn-sm btn-light px-2 departure-date-nav btn-next position-absolute end-0 top-50 translate-middle-y z-1 rounded-circle border shadow-sm section-shell" style="right: -8px !important;" onclick="scrollDates(this, 100)">
                    <i class="fas fa-arrow-right" style="color: #444;"></i>
                </button>
            </div>
        </div>

        <div class="mt-auto d-flex justify-content-between align-items-end pt-2 border-top">
            <div>
                <span class="text-dark" style="font-size: 0.9rem;">Giá từ:</span><br/>
                <span class="tour-price fw-bold" style="color: #dc3545; font-size: 1.4rem;">@Model.DisplayPrice.ToString("N0") <u>đ</u></span>
                @if (Model.DiscountPrice.HasValue)
                {
                    <span class="text-muted ms-1 text-decoration-line-through small">@Model.Price.ToString("N0")đ</span>
                }
            </div>
            <a asp-controller="Tour" asp-action="Details" asp-route-id="@Model.Id" class="btn" style="background-color: #175bb8; color: white; padding: 6px 16px; font-weight: 500; border-radius: 4px;">
                Xem chi tiết
            </a>
        </div>
    </div>
</div>

<script>
    if (typeof scrollDates !== 'function') {
        function scrollDates(btn, amount) {
            var container = btn.parentElement.querySelector('.departure-dates-container');
            if (container) {
                container.scrollBy({ left: amount, behavior: 'smooth' });
            }
        }
    }
</script>
