@model List<Tour>
@{
    ViewData["Title"] = "Quản lý Tour";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="fas fa-map-marked-alt text-primary me-2"></i>Quản lý Tour</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Thêm Tour mới</a>
</div>

<!-- Search / Filter -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: var(--radius);">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control form-control-sm" placeholder="Tìm kiếm theo tên, điểm đến..." />
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select form-select-sm" asp-items="@(ViewBag.Categories as SelectList)">
                    <option value="">-- Tất cả danh mục --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="fas fa-search me-1"></i>Lọc</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius: var(--radius);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Hình</th>
                        <th>Tên Tour</th>
                        <th>Mã Tour</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th>Điểm đến</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tour in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(tour.ImageUrl))
                                {
                                    <img src="@tour.ImageUrl" alt="" style="width:60px;height:40px;object-fit:cover;border-radius:6px;" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:60px;height:40px;">
                                        <i class="fas fa-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <strong>@tour.Name</strong>
                                @if (tour.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark ms-1"><i class="fas fa-star"></i></span>
                                }
                            </td>
                            <td><span class="badge bg-info bg-opacity-10 text-info font-monospace">@(string.IsNullOrEmpty(tour.TourCode) ? $"T{tour.Id:D3}" : tour.TourCode)</span></td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary">@tour.Category?.Name</span></td>
                            <td class="fw-bold">@tour.Price.ToString("N0")đ</td>
                            <td>@tour.Destination</td>
                            <td>
                                @if (tour.IsActive)
                                {
                                    <span class="badge bg-success">Hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ẩn</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-nowrap gap-1">
                                    <a asp-action="Details" asp-route-id="@tour.Id" class="btn btn-sm btn-outline-info" title="Xem">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Schedules" asp-route-id="@tour.Id" class="btn btn-sm btn-outline-warning" title="Quản lý lịch">
                                        <i class="fas fa-calendar-alt"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@tour.Id" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@tour.Id" method="post" class="m-0"
                                          onsubmit="return confirm('Bạn chắc chắn muốn xóa tour này?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
