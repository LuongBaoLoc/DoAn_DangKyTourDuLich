@model Category
@{
    ViewData["Title"] = "Thêm danh mục";
}

<h2 class="fw-bold mb-4"><i class="fas fa-plus-circle text-primary me-2"></i>Thêm Danh Mục Mới</h2>

<div class="card border-0 shadow-sm" style="border-radius: var(--radius); max-width: 600px;">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label fw-semibold"></label>
                <input asp-for="DisplayOrder" class="form-control" type="number" />
            </div>
            <div class="form-check mb-4">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Hiển thị</label>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
