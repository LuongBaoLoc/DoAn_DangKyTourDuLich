<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Sidebar -->
    <div class="admin-sidebar">
        <div class="text-center py-3 border-bottom border-secondary mb-3">
            <h5 class="fw-bold mb-0"><i class="fas fa-globe-asia me-2"></i>Admin Panel</h5>
            <small class="text-white-50">Quản trị hệ thống</small>
        </div>
        <nav class="nav flex-column px-2">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="fas fa-tachometer-alt"></i>Dashboard
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")"
               asp-area="Admin" asp-controller="Category" asp-action="Index">
                <i class="fas fa-th-list"></i>Danh mục Tour
            </a>
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
                var qType = Context.Request.Query["type"].ToString();
                var qStatus = Context.Request.Query["status"].ToString();
                bool isTourMenuOpen = ctrl == "Tour" || (ctrl == "Order" && (qType == "private" || qType == "group" || qStatus == "1"));
                bool isOrderMenu = ctrl == "Order" && !isTourMenuOpen;
            }
            <a class="nav-link @(isTourMenuOpen ? "active" : "")"
               data-bs-toggle="collapse" href="#tourMenu" role="button" aria-expanded="@(isTourMenuOpen ? "true" : "false")" aria-controls="tourMenu">
                <i class="fas fa-map-marked-alt"></i>Menu Tour
                <i class="fas fa-chevron-down float-end mt-1" style="font-size: 0.8em; transition: transform 0.3s; @(isTourMenuOpen ? "transform: rotate(180deg);" : "")"></i>
            </a>
            <div class="collapse @(isTourMenuOpen ? "show" : "")" id="tourMenu">
                <nav class="nav flex-column ms-3" style="font-size: 0.9em;">
                    <a class="nav-link py-2 @(ctrl == "Tour" ? "active text-white" : "text-white-50")" 
                       asp-area="Admin" asp-controller="Tour" asp-action="Index">
                        <i class="fas fa-list fa-sm me-2"></i>Tất cả Tour
                    </a>
                    <a class="nav-link py-2 @(ctrl == "Order" && qStatus == "1" && string.IsNullOrEmpty(qType) ? "active text-white" : "text-white-50")" 
                       asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="1">
                        <i class="fas fa-check-circle fa-sm me-2"></i>Tour đã xác nhận
                    </a>
                    <a class="nav-link py-2 @(ctrl == "Order" && qStatus == "1" && qType == "private" ? "active text-white" : "text-white-50")" 
                       asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="1" asp-route-type="private">
                        <i class="fas fa-user-friends fa-sm me-2"></i>Tour riêng
                    </a>
                    <a class="nav-link py-2 @(ctrl == "Order" && qStatus == "1" && qType == "group" ? "active text-white" : "text-white-50")" 
                       asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="1" asp-route-type="group">
                        <i class="fas fa-users fa-sm me-2"></i>Tour ghép
                    </a>
                </nav>
            </div>
            <a class="nav-link @(isOrderMenu ? "active" : "")"
               asp-area="Admin" asp-controller="Order" asp-action="Index">
                <i class="fas fa-shopping-cart"></i>Đơn hàng
            </a>
            <hr class="border-secondary" />
            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i>Về trang chủ
            </a>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link text-danger border-0 bg-transparent w-100 text-start">
                    <i class="fas fa-sign-out-alt"></i>Đăng xuất
                </button>
            </form>
        </nav>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
