@model List<Order>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    var currentStatus = ViewBag.CurrentStatus as OrderStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="fas fa-shopping-cart text-primary me-2"></i>Quản lý Đơn hàng</h2>
</div>

<!-- Filter by status -->
<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm @(currentStatus == null ? "btn-primary" : "btn-outline-primary") me-1">Tất cả</a>
    <a asp-action="Index" asp-route-status="0" class="btn btn-sm @(currentStatus == OrderStatus.Pending ? "btn-warning" : "btn-outline-warning") me-1">Chờ xác nhận</a>
    <a asp-action="Index" asp-route-status="1" class="btn btn-sm @(currentStatus == OrderStatus.Confirmed ? "btn-info" : "btn-outline-info") me-1">Đã xác nhận</a>
    <a asp-action="Index" asp-route-status="2" class="btn btn-sm @(currentStatus == OrderStatus.Completed ? "btn-success" : "btn-outline-success") me-1">Hoàn thành</a>
    <a asp-action="Index" asp-route-status="3" class="btn btn-sm @(currentStatus == OrderStatus.Cancelled ? "btn-danger" : "btn-outline-danger")">Đã hủy</a>
</div>

<div class="card border-0 shadow-sm" style="border-radius: var(--radius);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>SĐT</th>
                        <th>Tour</th>
                        <th>Tổng tiền</th>
                        <th>Ngày đặt</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Không có đơn hàng nào</td></tr>
                    }
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@order.OrderCode</strong></td>
                            <td>@order.CustomerName</td>
                            <td>@order.CustomerPhone</td>
                            <td>
                                @foreach (var item in order.OrderDetails)
                                {
                                    <small>@item.Tour?.Name (@item.Quantity người)</small><br />
                                }
                            </td>
                            <td class="fw-bold">@order.TotalAmount.ToString("N0")đ</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @switch (order.Status)
                                {
                                    case OrderStatus.Pending:
                                        <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                        break;
                                    case OrderStatus.Confirmed:
                                        <span class="badge bg-info">Đã xác nhận</span>
                                        break;
                                    case OrderStatus.Completed:
                                        <span class="badge bg-success">Hoàn thành</span>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <span class="badge bg-danger">Đã hủy</span>
                                        break;
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
