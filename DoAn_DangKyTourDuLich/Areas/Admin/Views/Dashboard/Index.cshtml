@model List<Order>
@{
    ViewData["Title"] = "Dashboard";
    var totalTours = (int)(ViewBag.TotalTours ?? 0);
    var totalCategories = (int)(ViewBag.TotalCategories ?? 0);
    var totalOrders = (int)(ViewBag.TotalOrders ?? 0);
    var pendingOrders = (int)(ViewBag.PendingOrders ?? 0);
    var totalRevenue = (decimal)(ViewBag.TotalRevenue ?? 0m);
    var currentYear = (int)(ViewBag.CurrentYear ?? DateTime.Now.Year);
    var monthlyRevenue = ViewBag.MonthlyRevenue as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<h2 class="fw-bold mb-4"><i class="fas fa-tachometer-alt text-primary me-2"></i>Dashboard</h2>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #667eea, #764ba2);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-number">@totalTours</div>
                    <div>Tour du lịch</div>
                </div>
                <div class="stat-icon"><i class="fas fa-map-marked-alt"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-number">@totalOrders</div>
                    <div>Đơn hàng</div>
                </div>
                <div class="stat-icon"><i class="fas fa-shopping-cart"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-number">@pendingOrders</div>
                    <div>Chờ xác nhận</div>
                </div>
                <div class="stat-icon"><i class="fas fa-clock"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #43e97b, #38f9d7);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-number" style="font-size: 1.2rem;">@totalRevenue.ToString("N0")</div>
                    <div>Doanh thu (VNĐ)</div>
                </div>
                <div class="stat-icon"><i class="fas fa-coins"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Chart: Doanh Thu -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100" style="border-radius: var(--radius);">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="fas fa-chart-line text-success me-2"></i>Doanh thu năm <span>@currentYear</span></h5>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" style="min-height: 250px;"></canvas>
            </div>
        </div>
    </div>
    <!-- Top Tours -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: var(--radius);">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fas fa-fire text-danger me-2"></i>Tour Hot (Đã bán)</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @{
                        var topTours = ViewBag.TopTours as IEnumerable<DoAn_DangKyTourDuLich.Areas.Admin.Controllers.DashboardController.TopTourViewModel> ?? new List<DoAn_DangKyTourDuLich.Areas.Admin.Controllers.DashboardController.TopTourViewModel>();
                        if (!topTours.Any())
                        {
                            <li class="list-group-item text-center text-muted py-4">Chưa có dữ liệu</li>
                        }
                        else
                        {
                            foreach (var tt in topTours)
                            {
                                <li class="list-group-item d-flex align-items-center py-3">
                                    <div class="me-3" style="width: 50px; height: 50px; border-radius: 8px; overflow: hidden; background-color: #f8f9fa;">
                                        @if (!string.IsNullOrEmpty(tt.ImageUrl))
                                        {
                                            <img src="@tt.ImageUrl" alt="@tt.TourName" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted"><i class="fas fa-image"></i></div>
                                        }
                                    </div>
                                    <div class="flex-grow-1 min-w-0">
                                        <h6 class="mb-1 text-truncate" title="@tt.TourName">@tt.TourName</h6>
                                        <div class="small text-muted d-flex justify-content-between">
                                            <span><i class="fas fa-users me-1"></i>@tt.TotalBookings</span>
                                            <span class="text-success fw-bold">@tt.TotalRevenue.ToString("N0") đ</span>
                                        </div>
                                    </div>
                                </li>
                            }
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders -->
<div class="card border-0 shadow-sm" style="border-radius: var(--radius);">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="fas fa-history text-primary me-2"></i>Đơn hàng gần đây</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Tour</th>
                        <th>Tổng tiền</th>
                        <th>Ngày đặt</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@order.OrderCode</strong></td>
                            <td>@order.CustomerName</td>
                            <td>
                                @foreach (var item in order.OrderDetails)
                                {
                                    <div class="mb-1">
                                        <span class="badge bg-info bg-opacity-10 text-info font-monospace me-1">@(string.IsNullOrEmpty(item.Tour?.TourCode) ? $"T{item.Tour?.Id:D3}" : item.Tour?.TourCode)</span>
                                        <small>@item.Tour?.Name</small>
                                    </div>
                                }
                            </td>
                            <td class="fw-bold">@order.TotalAmount.ToString("N0") VNĐ</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @switch (order.Status)
                                {
                                    case OrderStatus.Pending:
                                        <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                        break;
                                    case OrderStatus.Confirmed:
                                        <span class="badge bg-info">Đã xác nhận</span>
                                        break;
                                    case OrderStatus.Completed:
                                        <span class="badge bg-success">Hoàn thành</span>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <span class="badge bg-danger">Đã hủy</span>
                                        break;
                                }
                            </td>
                            <td>
                                <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var ctx = document.getElementById('revenueChart').getContext('2d');
            
            var monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyRevenue));
            var labels = monthlyData.map(function(item) { return item.Label; });
            var dataPoints = monthlyData.map(function(item) { return item.Revenue; });

            var myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh Thu (VNĐ)',
                        data: dataPoints,
                        backgroundColor: 'rgba(56, 249, 215, 0.5)',
                        borderColor: 'rgba(67, 233, 123, 1)',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let val = context.parsed.y;
                                    return new Intl.NumberFormat('vi-VN').format(val) + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    if(value >= 1000000) return (value / 1000000) + 'M';
                                    return value;
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
